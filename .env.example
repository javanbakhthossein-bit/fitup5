# ─── دیتابیس (SQLite) ───
# مسیر فایل دیتابیس.
# توصیه: مسیر مطلق بدهید تا بین build و اجرا ابهامی نباشد — مثال سرور:
#   DATABASE_URL=file:/var/www/fitup/db/custom.db
# در حالت standalone، سرور .env را از داخل .next/standalone می‌خواند
# (deploy.sh همان‌جا کپی می‌کند).
DATABASE_URL=file:/var/www/fitup/db/custom.db

# ─── کلید امضای سشن کاربران ───
# اختیاری: اگر خالی بماند، برنامه هنگام اولین لاگین یک کلید تصادفی امن تولید
# و در db/.session-secret ذخیره می‌کند (بین ری‌استارت‌ها و دیپلوی‌ها پایدار است).
# اگر می‌خواهید خودتان تعیین کنید (مثلاً برای چند سرور):
#   openssl rand -hex 32
# SESSION_SECRET=

# ─── v57 — کلید bridge ورود خودکار OTP در اپ‌ها ───
# با این کلید، سرور در پاسخ /api/auth/send-otp برای درخواست‌های «داخل اپ»
# (UA اپ + این کلید از FitUpNative.getOtpBridgeKey) کد را برمی‌گرداند تا کد
# بدون تایپ/دکمه در اپ جا بیفتد و کاربر مستقیم وارد پنل شود (مثل اسنپ).
# ⚠️ باید دقیقاً با buildConfigField "OTP_BRIDGE_SECRET" در هر دو اپ
#    (fitup-app و fitup-bazaar) یکی باشد. برای وب هیچ اثری ندارد.
# OTP_BRIDGE_SECRET=qQF51iWFt1rF6ZsacFQJqigxvfiJJ5sg6I3e_vGu2d4

# ─── هوش مصنوعی (AvalAI — سازگار با OpenAI) ───
AVALAI_API_KEY=your_key
AVALAI_BASE_URL=https://api.avalai.ir/v1
# 🆕 v73 — مهاجرت کامل به DeepSeek V4.1 Flash (دیریکتیو مالک: «کل سیستم با این
# هوش مصنوعی بره جلو؛ تولید برنامه تفکر مکس، بقیه low»)
#   • بینایی بومی (عکس غذا/بدن/چت + فریم ویدیو) ← همان مدل
#   • بین‌المللی نیست — فقط از طریق AvalAI؛ تعرفهٔ ثابت: $0.15 ورودی / $0.60 خروجی (هر 1M)
#   • deepseek-v4-flash قدیمی توسط DeepSeek بازنشسته شده — دیگر استفاده نشود
# ⚠️ مهم: اگر در envِ سرور مقادیر قدیمی (gemini-3.8-flash / deepseek-v4-flash) مانده،
# حتماً به مقادیر زیر به‌روزرسانی شود — envِ سرور بر پیش‌فرض کد اولویت دارد.
AVALAI_TEXT_MODEL=deepseek-v4.1-flash
AVALAI_VISION_MODEL=deepseek-v4.1-flash
AVALAI_TEXT_TASK_MODEL=deepseek-v4.1-flash
AVALAI_NIKA_MODEL=deepseek-v4.1-flash
AVALAI_ONBOARDING_MODEL=deepseek-v4.1-flash
AVALAI_PLAN_MODEL=deepseek-v4.1-flash
# فال‌بک مدل برای «همهٔ» نقاط AI (شامل تولید برنامه): gemini-3.8-flash —
# مدل اثبات‌شدهٔ قبلی سیستم. هر شکست نهایی (پاسخ خالی/نامعتبر، 400، 5xx، تایم‌اوت)
# بعد از اتمام تلاش‌های مدل اصلی، به این مدل می‌رود (قاعدهٔ «هرگز بی‌پاسخ نماند»).
AVALAI_FALLBACK_TEXT_MODEL=gemini-3.8-flash
AVALAI_FALLBACK_VISION_MODEL=gemini-3.8-flash
AVALAI_FALLBACK_PLAN_MODEL=gemini-3.8-flash
# تولید تصویر و TTS دست‌نخورده (مدل‌های تخصصی جدا از LLM)
AVALAI_IMAGE_API_KEY=your_key
AVALAI_IMAGE_MODEL=gemini-3.1-flash-lite-image
AVALAI_TTS_API_KEY=your_key

# ─── پرداخت (Zarinpal) ───
ZARINPAL_MERCHANT_ID=your_merchant_id

# ─── 🆕 v36 — پرداخت درون‌برنامه‌ای کافه‌بازار (اپ بازار) ───
# ⚠️ حیاتی: بدون اعتبارنامهٔ بازار هر خرید داخل اپ بازار با 500 رد می‌شود
# (فعال‌سازی پلن انجام نمی‌شود!) — عامل اصلی گزارش «خرید بازار ولی پلن فعال نشد».
# ✅ v55 — مقادیر واقعی از پیشخان بازار (بخش «API توسعه‌دهندگان» + «پرداخت درون‌برنامه‌ای»)
# اکنون تنظیم شده‌اند — هر سه مسیر راستی‌آزمایی فعال است:
#   ① OAuth Developer API (پیش‌فرض) ② توکن پیشخان ③ امضای RSA خرید (پشتیبان)
#
# 🆕 v48/v55 — API توسعه‌دهندگان بازار (OAuth — راستی‌آزمایی خرید؛ روش توصیه‌شده):
# Client Id/Secret ساخت‌شده در پیشخان بازار → بخش «API توسعه‌دهندگان»:
BAZAAR_CLIENT_ID=byvbZebXnM86x2gi4uELdt63gSJ2bXCNolhmQJNC
BAZAAR_CLIENT_SECRET=IanPHTi8Tc4S8BIaeo0W7nHv2h7qbSbCC5AFf1g6oWlE9YucM9pCpZ4SWLRK
# Client URI ثبت‌شده در پیشخان (https://fittup.ir/?screen=panel) — فقط برای ثبت
# در پنل بازار است و در کد نقشی ندارد.
#
# ✅ v55 — کلید RSA پرداخت درون‌برنامه‌ای (پیشخان → پرداخت درون‌برنامه‌ای → کلید RSA):
# همین کلید در متن اپ بازار هم هست (fitup-bazaar/app/build.gradle.kts → BAZAAR_RSA_PUBLIC_KEY)
# سرور با آن امضای هر خرید را محلی راستی‌آزمایی می‌کند (مسیر پشتیبان API):
BAZAAR_RSA_PUBLIC_KEY=MIHNMA0GCSqGSIb3DQEBAQUAA4G7ADCBtwKBrwDI6I3QKZLtAOura5/Ij4MTPlNJ7v9J0znWW1bMcRG54abj/V/FM7pj9F058QhNGcx6qu0moEegqZRvO8er08CWCdgklkdGbzaYLziKrKHql5Os4MAtAjM26juZ+o6F8WvnnoI3g6wG7HBagV73YaNS3eDTatWBoAkMzjchVKSZj/6rRGaRv5d+cfNyyzCCmASD/sk9dQkxH1g+dVFVzUqTdtey+uOxqbONGBJiHdUCAwEAAQ==
#
# توکن API پیشخان (مدیریت رهانش‌ها؛ به‌عنوان fallback راستی‌آزمایی هم کار می‌کند):
# از پیشخان بازار بگیرید: برنامه → API پیشخان بازار → دریافت توکن
# (یا بعد از دیپلوی از پنل ادمین → تنظیمات → bazaar_api_secret ست کنید)
# BAZAAR_API_SECRET=your_bazaar_pishkhan_api_token
# ✅ v55 — کلید JWT تخفیف پویا (پیشخان → پرداخت درون‌برنامه‌ای → کلید JWT تخفیف پویا):
# سرور با این کلید یک JWT کوتاه‌عمر (HS256) می‌سازد و قیمت پویا را در بازار ثبت می‌کند
# (اگر API کلید خام بخواهد، خودکار retry می‌شود — هر دو حالت پوشش داده شده)
BAZAAR_DYNAMIC_PRICE_TOKEN=nslCvAlYQSMDcTcBs83R2u_wEBIbVItzBA1EIPQUxWM
# پکیج اپ بازار (پیش‌فرض: ir.fittup.app)
# BAZAAR_PACKAGE_NAME=ir.fittup.app

# ─── پیامک (SMS.ir) ───
SMSIR_API_KEY=your_key
SMSIR_TEMPLATE_ID=your_template
# ─── پیامک «تیکت جدید» (قالب ۹۴۲۷۶۳ sms.ir — متغیر #NAME#) ───
# کد قالب در پنل sms.ir (اگر قالب جدید ساختید، عددش را بگذارید)
# SMSIR_TICKET_TEMPLATE_ID=942763
# شماره مدیر برای اطلاع تیکت جدید (پیش‌فرض: سوپرادمین)
# SMSIR_TICKET_ADMIN_MOBILE=09300083803
# ─── v61 — پیامک ۱۰۰٪ قالبی (دیریکتیو مالک: «همهٔ پیامک‌هام تحویل قالبی است نه بولک») ───
# همهٔ پیامک‌های فیتاپ (OTP، ترک درگاه، خریدها، یادآورها) از endpoint قالب (verify)
# می‌روند — مسیر bulk/متن آزاد به‌کلی حذف شد چون خط خدماتی sms.ir (+98500033003)
# فقط تحویل قالبی را پشتیبانی می‌کند و bulk با آن همیشه خطای «۱۰۱» می‌دهد.
# ⛔ SMSIR_USE_RAW_SEND — دیگر هیچ اثری ندارد (حذف از env اختیاری است).
# ⛔ SMSIR_LINE — برای OTP دیگر استفاده نمی‌شود؛ خالی بماند. (فقط اگر روزی خط
#    اختصاصی خریدید و WebOTP خام خواستید، دوباره موضوعیت پیدا می‌کند.)
# 🆕 کد قالب پیامک «ترک درگاه» (248945) — مثل بقیهٔ پیامک‌ها در env:
# متن قالب در پنل sms.ir با متغیرهای #NAME# و #LINK# تعریف شده است.
# اگر خالی بماند: از پنل ادمین → تنظیمات → abandoned_cart_sms_template_id خوانده
# می‌شود؛ اگر هیچ‌کدام نباشد پیامک ترک درگاه ارسال نمی‌شود (v61 — مسیر bulk حذف شد).
# SMSIR_ABANDONED_CART_TEMPLATE_ID=

# ─── نوتیفیکیشن PWA (Web Push) ───
VAPID_PUBLIC_KEY=your_key
VAPID_PRIVATE_KEY=your_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_key
# 🆕 v36 — سقف روزانه push به ازای هر کاربر (رفع پرچم «Chrome detected spam»)
# بعد از این تعداد اعلان در ۲۴ ساعت، اعلان فقط داخل اپ ذخیره می‌شود و push سیستم‌عامل نمی‌رود
# PUSH_DAILY_CAP=8

# ─── متفرقه ───
# محر CRUD های زمان‌بندی‌شده (یک رشته تصادفی بزرگ)
CRON_SECRET=your_secret
# آدرس عمومی سایت (برای sitemap و canonical ها)
NEXT_PUBLIC_SITE_URL=https://example.com
# فقط برای توسعه: OTP در پاسخ API برمی‌گردد (در production حذف کنید!)
# DEV_OTP_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# پیامک‌های سیستمی v32 — قالب‌های تأییدشدهٔ SMS.ir (متن قالب در پنل SMS.ir است)
# هر متغیر تنظیم نشود → آن سناریو بی‌صدا غیرفعال می‌شود (هیچ خطایی نمی‌دهد)
# ─────────────────────────────────────────────────────────────────────────────
# 669068 — آنبوردینگ ناتمام: ۳۰ دقیقه بعد از ثبت موبایل و خروج | متغیر: NAME
SMSIR_TEMPLATE_ONBOARDING_NUDGE=669068
# 461291 — ۲۴ ساعت بعد از تکمیل آنبوردینگ بدون خرید | متغیرها: NAME، CODE (کد تخفیف اختصاصی یک‌بارمصرفِ خرید اول — درصد از پنل مدیر)
SMSIR_TEMPLATE_ONBOARDING_WINBACK=461291
# 663678 — آماده شدن برنامه ورزشی روی پنل | متغیر: NAME
SMSIR_TEMPLATE_PROGRAM_READY=663678
# 761137 — فرا رسیدن چکاپ (همزمان با نوتیف چکاپ) | متغیر: NAME
SMSIR_TEMPLATE_CHECKUP_REMINDER=761137
# 322780 — منقضی شدن پلن (همزمان با نوتیف انقضا) | متغیرها: NAME، LINK (لینک تمدید مجزا — قالب: https://fittup.ir/#LINK#)
SMSIR_TEMPLATE_PLAN_EXPIRED=322780
# 🆕 v37 — یک روز تا انقضای پلن (کرون رفتاری، پنجرهٔ ~۳۰ ساعت مانده) | متغیرها: NAME، LINK (لینک تمدید مجزا)
# متن قالب: «فیتاپ / #NAME# عزیز. / پلن فعلی شما فردا منقضی میشود. از لینک زیر میتوانید مبلغ تمدید را
# پرداخت کنید تا پلن جدید بصورت خودکار برایتان فعال شود. / https://fittup.ir/#LINK# / هر بدنی فیتاپ میخواد!»
SMSIR_TEMPLATE_PLAN_EXPIRING=184777
# 852193 — دعوت دوست با پیامک (از صفحهٔ معرفی به دوست) | متغیرها: NAME (نام دوست)، LINK (لینک دعوت — قالب: https://fittup.ir/#LINK#)
SMSIR_TEMPLATE_INVITE_FRIEND=852193
# 604678 — ۷۲ ساعت بعد از انقضای پلن بدون تمدید (همزمان و سینک با نوتیف renewal_late) |
# متغیرها: NAME، CODE (کد تخفیف اختصاصی — درصد از پنل مدیر: expiry_discount_percent)، LINK (لینک تمدید مجزا)
SMSIR_TEMPLATE_EXPIRED_WINBACK=604678
# 🆕 v47 — پیامک خوش‌آمدگویی خرید: دقیقاً ۸ روز بعد از ثبت شماره موبایل، برای کاربرِ بدونِ خرید
# متن قالب (پنل SMS.ir):
#   «#NAME# عزیز / با فیتاپ زندگی ورزشیتو متحول کن. / برگرد به پنل کاربریت و با تخفیف جذابی که
#    برات در نظر گرفتیم فیتاپ رو تست کن و ببین که چطور لایف استایلت عوض میشه. / کد تخفیف: #CODE#
#    / لینک: https://fittup.ir/go/plans / هر بدنی فیتاپ میخواد!»
# متغیرها: NAME (آنبوردینگ ناتمام → «ورزشکار»، تکمیل → نام)، CODE (درصد از پنل مدیر: welcome_offer_discount_percent — پیش‌فرض ۳۰)
SMSIR_TEMPLATE_WELCOME_OFFER=612964
# 🆕 v47 — پیامک تقویت تمدید: ۸ روز بعد از انقضای پلن بدون تمدید (نردبان دوم پس از 604678)
# متن قالب (پنل SMS.ir):
#   «فیتاپ / #NAME# عزیز / ۸ روز از زمان تمدید پلنت گذشته، با تغییر برنامه به بدنت شوک بده.
#    با تخفیف جذابی که برات در نظر گرفتیم برنامه ورزشی جدید بگیر. / کد تخفیف: #CODE#
#    / لینک: https://fittup.ir/#LINK# / هر بدنی فیتاپ میخواد!»
# متغیرها: NAME، CODE (همان کد تمدید renewal — درصد از پنل مدیر: expiry_discount_percent — پیش‌فرض ۳۰)،
# LINK = go/renew?t=... (لینک هوشمند: اپ نصب بود → اپ باز می‌شود، نبود → تمدید وب)
SMSIR_TEMPLATE_RENEWAL_BOOST=883325
# 🆕 v33 — پیامک‌های خرید موفق (بلافاصله بعد از تأیید پرداخت درگاه؛ هر پرداخت موفق یک بار)
# متغیر نامشخص: اول با NAME تلاش می‌شود؛ اگر قالب متغیر نداشته باشد بدون پارامتر ارسال می‌شود (خودترمیم)
# 423726 — خرید پلن پیشرفته
SMSIR_TEMPLATE_PURCHASE_ADVANCED=423726
# 612405 — خرید پلن حرفه‌ای
SMSIR_TEMPLATE_PURCHASE_ULTIMATE=612405
# 565185 — خرید پلن اقتصادی یا استاندارد (هر دو یک قالب مشترک)
SMSIR_TEMPLATE_PURCHASE_BASIC=565185
# 🆕 v36 — پیامک ارتقای پلن (وقتی کاربر با اشتراک فعال، پلن بالاتر می‌خرد)
# متغیرها: #NAME# + #PLANBASE# (پلن قبلی) + #PLANUPDATE# (پلن جدید) — نام‌ها فارسی از PLAN_LABELS
# 275042 — ارتقا از اقتصادی/استاندارد به پیشرفته/حرفه‌ای
SMSIR_TEMPLATE_PLAN_UPGRADE_PREMIUM=275042
# 324322 — فقط ارتقا از اقتصادی به استاندارد (همان الگوی متغیرها)
SMSIR_TEMPLATE_PLAN_UPGRADE_STANDARD=324322
# 🆕 v36/v37 — پیامک شارژ کیف پول (بعد از تأیید پرداخت توسط سایت)
# متن قالب: «فیتاپ / #NAME# عزیز / کیف پول شما به مبلغ #PRICE# شارژ شد. / هر بدنی فیتاپ میخواد!»
# نردبان خودترمیم [NAME+AMOUNT] → [NAME] → [] — متغیر دوم جای #PRICE# می‌نشیند (مبلغ با جداکننده انگلیسی)
SMSIR_TEMPLATE_WALLET_TOPUP=556023

# ─── تحلیل هوشمند: از v60 فقط دستی است (دکمهٔ پنل ادمین) — env خودکار حذف شد ───

# ─── v56: OTP خودکار در اپ (خواندن کد از سرور — OTP Bridge) ───
# قالب OTP اختصاصی اپ خودمان (اگر در پنل sms.ir ساخته شد؛ اختیاری — پیش‌فرض 829644)
# SMSIR_TEMPLATE_OTP_OWN=
# قالب OTP اختصاصی اپ بازار (اختیاری — پیش‌فرض 829644)
# SMSIR_TEMPLATE_OTP_BAZAAR=
