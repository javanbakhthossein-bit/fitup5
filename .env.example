# ═══════════════════════════════════════════════════════════════
# فیتاپ — نمونهٔ env سرور تولید (همراه هر زیپ دیپلوی)
# مقادیر واقعی را فقط روی سرور در .env وارد کنید — این فایل هرگز مقدار واقعی ندارد.
# ═══════════════════════════════════════════════════════════════

# ─── دیتابیس ───
DATABASE_URL=file:/var/www/fitup/db/custom.db

# ─── هوش مصنوعی (AvalAI) ───
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_TEXT_MODEL=deepseek-v4.1-flash
AVALAI_VISION_MODEL=deepseek-v4.1-flash
AVALAI_TEXT_TASK_MODEL=deepseek-v4.1-flash
AVALAI_NIKA_MODEL=deepseek-v4.1-flash
AVALAI_ONBOARDING_MODEL=deepseek-v4.1-flash
AVALAI_IMAGE_API_KEY=
AVALAI_IMAGE_MODEL=gemini-3.1-flash-lite-image
AVALAI_TTS_API_KEY=
AVALAI_FALLBACK_TEXT_MODEL=gemini-3.8-flash
AVALAI_FALLBACK_VISION_MODEL=gemini-3.8-flash

# ─── پرداخت زرین‌پال ───
ZARINPAL_MERCHANT_ID=

# ─── امنیت ───
SESSION_SECRET=
CRON_SECRET=
OTP_BRIDGE_SECRET=

# ─── پیامک SMS.ir ───
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=829644
SMSIR_USE_RAW_SEND=true
SMSIR_TICKET_TEMPLATE_ID=
SMSIR_TICKET_ADMIN_MOBILE=
SMSIR_TEMPLATE_ONBOARDING_NUDGE=
SMSIR_TEMPLATE_ONBOARDING_WINBACK=
SMSIR_TEMPLATE_PROGRAM_READY=
SMSIR_TEMPLATE_CHECKUP_REMINDER=
SMSIR_TEMPLATE_PLAN_EXPIRED=
SMSIR_TEMPLATE_INVITE_FRIEND=
SMSIR_TEMPLATE_EXPIRED_WINBACK=
SMSIR_TEMPLATE_PURCHASE_ADVANCED=
SMSIR_TEMPLATE_PURCHASE_ULTIMATE=
SMSIR_TEMPLATE_PURCHASE_BASIC=
SMSIR_TEMPLATE_PLAN_EXPIRING=
SMSIR_TEMPLATE_PLAN_UPGRADE_PREMIUM=
SMSIR_TEMPLATE_PLAN_UPGRADE_STANDARD=
SMSIR_TEMPLATE_WALLET_TOPUP=
SMSIR_TEMPLATE_WELCOME_OFFER=
SMSIR_TEMPLATE_RENEWAL_BOOST=
SMSIR_ABANDONED_CART_TEMPLATE_ID=

# ─── نوتیفیکیشن وب‌پوش (VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── سایت ───
NEXT_PUBLIC_SITE_URL=https://fittup.ir

# ─── کافه‌بازار (خرید درون‌برنامه‌ای اپ) ───
BAZAAR_PACKAGE_NAME=ir.fittup.app
# v209 — «کلید JWT تخفیف پویا» از پیشخان بازار (پرداخت درون‌برنامه‌ای → کلید JWT).
# این مقدار «کلید امضاست» نه توکن؛ سرور با آن JWT یکبارمصرف تخفیف پویا می‌سازد
# (HS256؛ payload: price ریال + package_name + sku + exp + nonce) و اپ همان JWT
# را در PurchaseRequest(dynamicPriceToken=…) به پولکی می‌دهد.
BAZAAR_DYNAMIC_PRICE_TOKEN=
BAZAAR_API_SECRET=
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=

# ─── ربات بله ───
BALE_BOT_TOKEN=

# ─── اختیاری ───
# پراکسی Google Search Console (اگر لازم شد)
GSC_PROXY_URL=

# ⚠️ هرگز روی سرور production این دو را تنظیم نکنید:
# DEV_OTP_ENABLED=true   ← فقط سندباکس/تست (برگرداندن کد OTP در پاسخ API)
# PAYMENT_SANDBOX=true   ← فقط سندباکس/تست (شبیه‌سازی درگاه)

# ─── v202 — الزامی: هویت مدیر + کلید bridge اپ‌ها ───
# شماره موبایل مالک/ادمین (فقط در env سرور — هرگز در سورس نیست)
ADMIN_MOBILE=09xxxxxxxxx
# رمز دوم ادمین (اختیاری — خالی = دومن‌فاکتور غیرفعال)
ADMIN_PASSWORD=
# کلید bridge ورود خودکار OTP اپ‌ها — باید با build.gradle.kts اپ‌ها یکی باشد
OTP_BRIDGE_SECRET=
# کلیدهای قدیمی اپ‌های نصب‌شده (حین چرخش کلید — کاما-جداشده)
OTP_BRIDGE_LEGACY_SECRETS=

# ═══════════════════════════════════════════════════════════════════════
# v230.4 — ممیزی کامل: کلیدهای عملیاتی که کد می‌خواند ولی بالا فهرست نشده بودند
# (همگی پیش‌فرض امن دارند — فقط در صورت نیاز از حالت کامنت خارج کنید.
#  مقادیر واقعی BAZAAR از پیشخان مالک؛ در ‎.env سرور موجود است.)
# ═══════════════════════════════════════════════════════════════════════
# FCM_SERVICE_ACCOUNT_JSON=            # پوش نوتیف FCM v1 (فایل/JSON سرویس‌اکانت)
# FCM_LEGACY_SERVER_KEY=               # پوش legacy FCM
# BAZAAR_CLIENT_ID=                    # OAuth API توسعه‌دهندگان بازار
# BAZAAR_CLIENT_SECRET=                # OAuth API توسعه‌دهندگان بازار
# BAZAAR_RSA_PUBLIC_KEY=               # راستی‌آزمایی امضای خرید درون‌برنامه‌ای
# BAZAAR_DYNAMIC_PRICE_TOKEN=          # کلید JWT تخفیف پویا
# BAZAAR_API_SECRET=                   # توکن کامل API پیشخان بازار
# SESSION_SECRET_FILE=                 # مسیر فایل حاوی رمز نشست (به‌جای متغیر خام)
# SMSIR_TEMPLATE_OTP_OWN=              # قالب OTP اپ اختصاصی
# SMSIR_TEMPLATE_OTP_BAZAAR=           # قالب OTP اپ بازار
# SMSIR_TEMPLATE_PAYMENT_LINK=         # قالب پیامک لینک پرداخت
# ENABLE_PASSWORD_REGISTER=false       # ثبت‌نام با رمز عبور
# UPLOADS_DIR=uploads                  # ریشهٔ رسانه‌های خصوصی کاربران
# FFMPEG_PATH=/usr/bin/ffmpeg          # فشرده‌سازی/تصویر شاخص ویدیو
# FFPROBE_PATH=/usr/bin/ffprobe
# ADMIN_MOBILE=                        # موبایل ادمین اصلی (ورود پنل)
# INDEXNOW_KEY=                        # کلید IndexNow موتورهای جستجو
# OTP_BRIDGE_LEGACY_SECRETS=           # رمزهای قدیمی پل OTP (مهاجرت)
