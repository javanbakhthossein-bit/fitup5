<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- اسپلش برندینگ تا آماده شدن اولین صفحه (شروع با OTP) — v78 (Task 4-e):
             طبق دستور مالک: فقط لوگوی فیتاپ + برند + شعار «هر بدنی فیتاپ میخواد!»
             (عکس هیرو hero_splash حذف شد) — انیمیشن‌ها در MainActivity:
             ورود اورشوت لوگو + شناوری/تپش پیوسته + دو نقطهٔ مداری + فید برند/شعار/اسپینر -->
        <FrameLayout
            android:id="@+id/splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/splash_bg">

            <!-- ستون مرکزی: لوگو، برند، شعار، پیشرفت (شناسه‌ها برای binding — بدون getChildAt) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <!-- محفظهٔ مدار: لوگو در مرکز؛ دو نقطهٔ مداری (نارنجی/کهربایی) در
                     MainActivity ساخته و با translationX/Y دور لوگو می‌چرخند
                     (۱۶۰dp برای مدار ۷۲dp — نقطه‌ها از قاب بیرون نمی‌زنند) -->
                <FrameLayout
                    android:id="@+id/logoOrbit"
                    android:layout_width="160dp"
                    android:layout_height="160dp">

                    <ImageView
                        android:id="@+id/splashLogo"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:contentDescription="لوگوی فیتاپ"
                        android:src="@drawable/fitup_logo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/splashTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="فیتاپ"
                    android:textColor="@color/splash_title"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/splashSlogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/splash_slogan"
                    android:textColor="#64748b"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/splashSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:indeterminateTint="#f97316" />
            </LinearLayout>
        </FrameLayout>

        <!-- صفحه خطای شبکه — فارسی با دکمه تلاش مجدد (به‌جای صفحه خطای انگلیسی WebView) -->
        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/splash_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="خطای اتصال"
                android:src="@mipmap/ic_launcher"
                android:alpha="0.35" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="اتصال برقرار نشد"
                android:textColor="@color/splash_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="اینترنت خود را بررسی کنید؛ برای پرداخت، فیلترشکن (VPN) را خاموش کنید"
                android:textColor="#64748b"
                android:textSize="14sp" />

            <Button
                android:id="@+id/errorRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#f97316"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="تلاش مجدد"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
