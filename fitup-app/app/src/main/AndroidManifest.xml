<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اپ یک WebView از سایت فیتاپ است؛ فقط اینترنت لازم است (حداقل دسترسی) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- نوتیف سیستم اندروید ۱۳+ (runtime request از خود سایت) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ⛔ v1.2.8 — REQUEST_INSTALL_PACKAGES عمداً حذف شد.
         علت: این مجوز «می‌تواند APK نصب کند» = پرچم قرمز امنیتی Play Protect و
         عامل اصلی مسدودشدن اپ روی بعضی گوشی‌ها (شکایت واقعی کاربران).
         آپدیت اپ حالا با «مرورگر بیرونی» انجام می‌شود: لینک APK در مرورگر باز
         می‌شود؛ مرورگر خودش مجوز نصب را دارد، دانلود را با نوتیف انجام می‌دهد و
         نصب را پیشنهاد می‌دهد — بدون هیچ مجوز حساسی روی خود اپ. -->
    <!-- v31 — رسیدن اعلان‌ها حتی وقتی برنامه بسته است:
         دیالوگ اختیاری فارسی یک‌بار-محور (requestBatteryOptimization از پل وب،
         بعد از رضایت اعلان‌ها) — بدون این پرمیشن سیستم intent نمی‌پذیرد.
         مصرف باتری به‌طور محسوسی بالا نمی‌رود (فقط JobScheduler/WorkManager) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v1.2.5 — ماندگاری اعلان‌های دوره‌ای بعد از ریبوت:
         WorkManager برای بازچینش کارهای دوره‌ای بعد از خاموش/روشن شدن گوشی به این
         پرمیشن نیاز دارد (کتابخانهٔ work-runtime خودش آن را merge می‌کند؛ اینجا
         صریحاً نوشته شده تا وابسته به merge پنهان نباشد) — کم‌مصرف، بدون سرویس دائمی -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ⛔ عمداً هیچ پرمیشن پیامک (RECEIVE_SMS/READ_SMS/SEND_SMS) وجود ندارد.
         علت ریشه‌ای: از اندروید ۱۳+ پرمیشن‌های SMS «محدود» هستند و برای اپ‌های
         خارج از گوگل‌پلی (سایدلود/بازار) سیستمی که همان دیالوگ ترسناک
         «App was denied access» نشان می‌دهد اجازهٔ اعطا را کلاً می‌بندد؛
         یعنی درخواستش هم بی‌فایده است و هم اعتماد کاربر را می‌شکند.
         ورود خودکار OTP حالا بدون هیچ پرمیشنی انجام می‌شود:
         ۱) autocomplete="one-time-code" روی ورودی کد → پیشنهاد سیستم/کیبورد
         ۲) اتو-درج از کلیپ‌بورد (maybeDispatchClipboardOtp)
         ۳) SMS Retriever رسمی گوگل (v31 — بدون پرمیشن؛ پیامک با هش اپ امضا می‌شود)
         ۴) ورود دستی. -->

    <!-- دوربین/میکروفون وب: مجوزها «در زمان استفاده» گرفته می‌شوند — نه در استارتاپ.
         WebChromeClient.onPermissionRequest دقیقاً وقتی اجرا می‌شود که سایت ضبط صدا
         (ویس چت) یا ویدیو (آنالیز ویدیویی تمرین/بدن) بخواهد؛ کاربر ابتدا دیالوگ
         فارسی اجازه را می‌بیند و بعد دیالوگ سیستمی اندروید. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitUp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v1.2.5 — Android App Links: باز شدن لینک‌های https://fittup.ir داخل اپ
                 (به‌جای مرورگر). تأیید مالکیت دامنه با فایل
                 /.well-known/assetlinks.json روی سایت — فقط https و فقط دامنهٔ خودمان،
                 پارامترها (?tab= ?ref= ?renewal= ?screen= ?article=) دست‌نخورده می‌مانند -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fittup.ir" />
                <!-- v1.3.0 — پوشش زیردامنهٔ www (بعضی لینک‌های پیامک/وبلاگ با www می‌آیند) -->
                <data android:scheme="https" android:host="www.fittup.ir" />
            </intent-filter>
            <!-- v1.2.6 — اسکیم اختصاصی fitup:// برای لینک‌های هوشمند پیامک:
                 دستگاه‌های بدون سرویس گوگل autoVerify را تأیید نمی‌کنند و لینک
                 https در مرورگر باز می‌شد. صفحهٔ /go سایت با intent:// این اسکیم
                 را صدا می‌زند (fitup://open?url=...) تا اپ مستقیم باز شود؛
                 اگر اپ نصب نبود، همان لینک در مرورگر fallback می‌شود -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fitup" />
            </intent-filter>
        </activity>

        <!-- v1.4 (Task 2-d) — FCM: «اعلان‌ها حتی وقتی اپ کلاً بسته است».
             سرویس FCM — فقط وقتی FirebaseApp در MainActivity راه‌اندازی شده باشد
             فعال می‌شود (بدون google-services.json؛ مقادیر از strings.xml).
             اگر fcm_* خالی باشند این سرویس هرگز صدا زده نمی‌شود — بدون هیچ خطایی. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fitup_general" />
        <service
            android:name=".FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
