// Prisma schema for Smart Coach Fitness App
// Persian RTL AI Fitness Coach

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== USER & AUTH =====================
model User {
  id              String       @id @default(cuid())
  mobile          String       @unique // شماره موبایل (11 رقمی)
  passwordHash    String       @default("") // برای کاربران OTP خالی است
  name            String?      // نام نمایشی
  avatarUrl       String?      // آدرس عکس پروفایل (webp ریسایزشده در uploads/avatar)
  role            String       @default("USER") // USER | ADMIN
  isBlocked       Boolean      @default(false)
  // ─── v202 ممیزی (M2) — اپوک سشن برای ابطال سمت سرور ───
  // توکن سشن شمارهٔ اپوک لحظهٔ صدور را حمل می‌کند؛ getCurrentUser توکنی که
  // اپوکش کمتر از این فیلد باشد را رد می‌کند. پیش‌فرض ۰ = همهٔ توکن‌های موجود
  // (بدون sv یا sv=۰) معتبر می‌مانند — رفتار «هرگز لاگ‌اوت نشدن» (v32) عیناً حفظ
  // است؛ فقط ادمین با اکشن force_logout این عدد را ++ می‌کند تا همهٔ توکن‌های
  // قبلی (شامل سرقت‌شده) بی‌اثر شوند.
  sessionEpoch    Int          @default(0)
  onboardingDone  Boolean      @default(false)
  // زمان دقیق تکمیل آنبوردینگ — برای سناریوی پیامک «۲۴ ساعت بعد از تکمیل
  // آنبوردینگ و عدم خرید» (قالب 461291). برای کاربران قدیمی از backfill
  // پر می‌شود (از updatedAt پروفایل/کاربر).
  onboardingCompletedAt DateTime?

  // --- Plan & Wallet (4-tier subscription system) ---
  planName        String?      // basic | standard | advanced | ultimate (null = بدون پلن فعال)
  planExpiresAt   DateTime?    // تاریخ انقضای پلن فعلی
  planStartedAt   DateTime?    // تاریخ شروع پلن فعلی
  walletBalance   Int          @default(0) // موجودی کیف پول به تومان

  // --- AI usage counters (reset on new plan / tracked cumulatively) ---
  videoAnalysisUsed  Int       @default(0) // دفعات استفاده آنالیز ویدیویی (Ultimate)
  bloodTestUsed      Int       @default(0) // دفعات استفاده تحلیل آزمایش خون (Ultimate)
  // ممیزی 1-f#7 — "pending_blood_test" هم مقدار معتبر است (blood-test-status route/store.ts)
  bloodTestStatus    String?   // null = حالت اولیه | "pending_blood_test" = آزمایش داده، منتظر نتایج | "waiting" = منتظر نتایج | "declined" = رد شده
  // وضعیت تعیین‌تکلیف ویدیو (Ultimate): null = هنوز تصمیم نگرفته | "uploaded" = آپلود شده | "skipped" = رد شده
  // این فیلد برای جلوگیری از ساخت زودهنگام برنامه استفاده می‌شود — تا کاربر تصمیم نگیرد، برنامه ساخته نمی‌شود.
  videoStatus        String?   // null | "uploaded" | "skipped"

  // --- Activity tracking (رفع ریشه‌ای نوتیف «چند روزی نیستی») ---
  // آخرین بار که کاربر واقعاً اپ/سایت را باز کرده (auth/me در هر بازدید
  // لمس می‌کند؛ verify-otp در هر لاگین). سناریو re_engagement از این فیلد
  // به‌عنوان سیگنال اصلی «استفاده از اپ» استفاده می‌کند — قبلاً فقط ثبت
  // وزن/چکاپ/چت سنجیده می‌شد و کاربری که مدام اپ را باز می‌کرد ولی چیزی
  // ثبت نمی‌کرد، اشتباهی «غایب» تلقی می‌شد.
  lastActiveAt       DateTime? // null = هرگز (کاربر قدیمی قبل از این فیلد)

  // --- PWA Install Tracking ---
  // تاریخ نصب برنامه روی دستگاه کاربر (اگر نصب کرده باشد)
  // برای جلوگیری از ارسال نوتیف نصب اپ به کاربرانی که قبلاً نصب کرده‌اند
  pwaInstalledAt     DateTime? // null = نصب نشده

  // --- Native App Install Tracking (اپ اختصاصی / کافه‌بازار) ---
  // منبع تشخیص: User-Agent مخصوص هر اپ داخل WebView (FitUpApp/ = پنل اختصاصی،
  // FitUpBazaar/ = نسخهٔ کافه‌بازار). auth/me و verify-otp آن را ثبت می‌کنند.
  // مقادیر: null | "panel" | "bazaar" | "pwa"
  appInstallSource   String?   // null = اپ نیتیو ثبت نشده
  appInstalledAt     DateTime? // اولین بار که اپ نیتیو دیده شد (PWA از pwaInstalledAt جدا می‌ماند)

  // --- Terms & Conditions ---
  acceptedTermsVersion Int?     // شماره نسخه قوانینی که کاربر پذیرفته است

  // ─── v171 — منبع ورود کاربر (سند بازطراحی جریان پرداخت) ───
  // مقادیر: "instagram" | "app_android" | "web" | "unknown" — هر منبع enum
  // مستقل است و هرگز با بقیه ترکیب نمی‌شود. اولین‌بار در اولین تعامل پرداختی
  // (checkout / intent / send-link) از روی User-Agent درخواست ثبت می‌شود.
  // اپ کافه‌بازار عمداً در این دسته‌بندی نمی‌آید (مستثنا — دست‌نخورده).
  entrySource      String?   // null = هنوز ثبت نشده

  // ─── v178 — منبع ثبت‌نام کاربر (داشبورد «کاربران از کجا می‌آیند») ───
  // مقادیر: "instagram" | "google" | "cafebazaar" | "app_panel" | "web" | "other"
  // null = کاربران قدیمیِ قبل از v178 (نامشخص). تشخیص: UA اپ‌ها (FitUpBazaar →
  // cafebazaar، FitUpApp → app_panel) + utm_source/referrer سمت کلاینت (وب) —
  // یک‌بار در لحظهٔ ثبت‌نام (verify-otp) ثبت و هرگز تغییر نمی‌کند.
  signupSource       String?
  signupSourceDetail String?  // جزئیات خام (مقدار utm_source یا دامنهٔ referrer) — برای ممیزی

  // --- Referral System (معرفی به دوست‌دار) ---
  referralCode       String?  @unique // کد معرفی منحصربه‌فرد (مثلاً FIT-A7X3K9)
  referredById       String?  // شناسه کاربری معرف (در صورت ورود با لینک معرفی)
  referralRewardPaid Boolean  @default(false) // آیا پاداش معرفی پرداخت شده است

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  profile         OnboardingProfile?
  workoutPlans    WorkoutPlan[]
  mealPlans       MealPlan[]
  programRequests ProgramRequest[]
  weightLogs      WeightLog[]
  workoutDayStatuses WorkoutDayStatus[]
  progressPhotos  ProgressPhoto[]
  chatMessages    ChatMessage[]
  nikaMessages    NikaMessage[]
  notifications   Notification[]
  subscriptions   Subscription[]
  payments        Payment[]
  walletTxns      WalletTransaction[]
  articles        Article[]
  checkups        Checkup[]
  userDiscountCodes UserDiscountCode[]
  supportTickets  SupportTicket[]
  ticketReplies   TicketReply[]
  ticketAttachments TicketAttachment[]
  dayCompletions  DayCompletion[]
  challengeProgress ChallengeProgress[] // v183 — پیشرفت چالش‌های فیتاپ (رایگان برای همه)
  quotaUsages     QuotaUsage[]
  adminPermissions AdminPermission?
  analysisResults AnalysisResult[]
  errorLogs        ErrorLog[]
  funnelEvents     FunnelEvent[] // v198 — رویدادهای قیف فروش (دیرکتیو مالک)
  foodLogs        FoodLog[]
  surveys         Survey[]
  adminNotes      UserAdminNote[]
  deviceTokens    DeviceToken[]
  toolUsages      ToolUsage[] // Task 5-e — قیف ابزارهای رایگان
  appUsageLogs    AppUsageLog[] // v104 — زمان مصرف اپ‌ها (داشبورد مدیر)
  pushSubscriptions PushSubscription[] // ممیزی 1-f#8 — رابطهٔ واقعی (حذف کاربر = حذف اشتراک پوش)
  activitySessions ActivitySession[] // v138 — مسیریاب پیاده‌روی/دویدن
  bodyCompositions BodyComposition[] // v159 — تاریخچهٔ تشخیص قطعی ترکیب بدن (T6)
  paymentTokens   PaymentToken[] // v171 — توکن‌های امن پرداخت (لینک پیامکی/پل اپ)
  workoutSetLogs  WorkoutSetLog[] // v215 — لاگ ماندگار ست‌ها/وزنه‌ها (دیرکتیو مالک: پیشرفت قدرتی هر حرکت)
}

// ===================== ERROR LOGS (مدیریت خطاها) =====================
// ذخیره خطاهای client-side (window.onerror)، API route‌ها و server components
// برای بررسی ادمین و رفع باگ‌ها
model ErrorLog {
  id          String   @id @default(cuid())
  // نوع منبع خطا: "client" (window.onerror) | "api" (API routes) | "server" (server components)
  source      String   // "client" | "api" | "server"
  // کد وضعیت HTTP (برای خطاهای API) یا 0 برای خطاهای client
  statusCode  Int      @default(0)
  // پیام خطا (رشته واقعی خطا)
  message     String
  // Stack trace (در صورت موجود بودن)
  stack       String?
  // URL محل وقوع خطا (page URL یا API path)
  url         String   @default("")
  // HTTP method (برای خطاهای API)
  method      String?  // "GET" | "POST" | ...
  // شناسه کاربر در صورت لاگین بودن (nullable برای خطاهای ناشناس)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // اطلاعات مرورگر / User Agent
  userAgent   String?  @default("")
  // زمینه اضافی (JSON string — request body، query params و غیره)
  context     String?  @default("{}")
  // آیا این خطا توسط ادمین بررسی شده است
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([userId])
  @@index([reviewed])
}

// ===================== ANALYSIS RESULTS (آزمایش خون / ویدیو / عکس بدن) =====================
// نتایج تحلیل آزمایش خون، ویدیو و عکس بدن برای نمایش در UI (رفرش صفحه اطلاعات را از بین نمی‌برد)
model AnalysisResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "blood_test" | "video_analysis" | "body_photo"
  result    String   // JSON string with full analysis
  mediaUrl  String?  // URL of the analyzed media (if any)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  // ممیزی 1-f#2 — سرو مدیا خصوصی با mediaUrl جستجو می‌کند
  @@index([mediaUrl])
}

// ===================== ADMIN PERMISSIONS (دسترسی مجزا ادمین) =====================
model AdminPermission {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // دسترسی‌های مجزا — هر کدام true/false
  canViewDashboard   Boolean @default(true)
  canManageUsers     Boolean @default(true)
  canViewFinance     Boolean @default(true)
  canManagePrograms  Boolean @default(true)
  canManageCheckups  Boolean @default(true)
  canManageArticles  Boolean @default(true)
  canManageHeadCodes Boolean @default(true)
  canManageTerms     Boolean @default(true)
  canUseCopilot      Boolean @default(true)
  canManageAdmins    Boolean @default(false) // فقط سوپرادمین
  canManageTickets   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===================== SUPPORT TICKETS (تیکت پشتیبانی) =====================
model SupportTicket {
  adminReadAt   DateTime? // v73.3 — آخرین بار ادمین تیکت را دید (بج خوانده‌نشده)
  userReadAt    DateTime? // v79 — آخرین بار مالک تیکت را دید (بج خوانده‌نشده سمت کاربر:
  // آخرین پاسخ ادمین بعد از این لحظه → برای کاربر خوانده‌نشده)
  id          String   @id @default(cuid())
  userId      String   // شناسه کاربر (ورزشکار) که تیکت را زده
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String   // موضوع تیکت
  category    String   @default("general") // general | technical | payment | program | bug
  priority    String   @default("normal") // low | normal | high | urgent
  status      String   @default("open") // open | answered | closed
  message     String   // متن تیکت
  adminReply  String?  // پاسخ مدیر (متن)
  repliedById String?  // شناسه ادمینی که پاسخ داده
  repliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  replies     TicketReply[]
  attachments TicketAttachment[] // v77 — پیوست‌های خودِ تیکت (عکس/ویدیو/فایل)

  @@index([userId])
  @@index([status])
}

model TicketReply {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String   // شناسه فرستنده (کاربر یا ادمین)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // user | admin
  message     String   // متن پاسخ
  createdAt   DateTime @default(now())
  attachments TicketAttachment[] // v77 — پیوست‌های همین پاسخ

  @@index([ticketId])
  @@index([userId])
}

// ===================== v77 — پیوست فایل تیکت (عکس/ویدیو/فایل) =====================
// درخواست مالک: کاربر و مدیر باید بتوانند عکس/ویدیو/فایل در تیکت بفرستند و
// فایل‌ها برای پیگیری‌های بعدی «همیشه» بمانند (سیاست keep-forever —
// /api/cron/cleanup-media چیزی را حذف نمی‌کند). فایل روی دیسک در
// uploads/tickets/ ذخیره می‌شود و فقط با auth + مالکیت تیکت سرو می‌شود
// (الگوی رسانه خصوصی — canAccessPrivateMedia).
model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String?  // پس از اتصال به تیکت/پاسخ set می‌شود (آپلود اول standalone است)
  ticket     SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  replyId    String?
  reply      TicketReply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName   String   // نام اصلی فایل برای نمایش
  fileType   String   // MIME type
  fileSize   Int      // بایت
  fileUrl    String   // /uploads/tickets/… (خصوصی — auth + مالکیت)
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@index([replyId])
  @@index([uploaderId])
  @@index([fileUrl])
}

// ===================== ONBOARDING =====================
model OnboardingProfile {
  nutritionNotes      String?  // v73.3 — یادداشت‌های تغذیه‌ای کاربر از دستیار تغذیه (تزریق به پروندهٔ ورزشی)
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender          String   // male | female
  age             Int
  height          Int      // cm
  weight          Float    // kg
  targetWeight    Float?   // kg
  goal            String   // fat_loss | muscle_gain | endurance | fitness | strength
  activityLevel   String   // sedentary | light | moderate | active | very_active
  workoutDays     Int      // تعداد روزهای تمرین در هفته
  workoutDaysList String   @default("[]") // JSON array of specific weekday names (شنبه، یکشنبه، ...)
  workoutPlace    String   // gym | home | both
  equipment       String   // JSON array of available equipment
  diseases        String   @default("") // سوابق بیماری
  injuries        String   @default("") // آسیب‌دیدگی‌های مفصلی/عضلانی
  allergies       String   @default("") // حساسیت‌های غذایی
  dietType        String   @default("standard") // standard | vegetarian | vegan | keto
  // v81 — تعداد وعده‌های غذایی رغبتی کاربر (۳-۶) — در آنبوردینگ انتخاب و در
  // پرامپت برنامهٔ غذایی لحاظ می‌شود (قبلاً انتخاب کاربر بی‌صدا دور ریخته می‌شد)
  mealCount       Int?

  // --- Professional advanced fields (for pro athletes) ---
  trainingExperience   String?  // سابقه ورزشی: beginner | intermediate | advanced | pro
  previousTrainingType String?  // نوع تمرین قبلی (متن آزاد)
  drugAllergies        String?  // آلرژی‌های دارویی
  currentMedications   String?  // داروهای مصرفی فعلی
  maxLifts             String?  // حداکثر وزنه‌ها (اسکوات/پرس سینه/ددلیفت)

  // --- NEW: Comprehensive professional onboarding fields (ONBOARDING-PLAN-UPGRADE) ---
  bodyFrame            String?  // small | medium | large — اندازه استخوان بدن (افکت روی وزن ایده‌آل)
  sleepHours           Int?     // 4-12 — میانگین ساعت خواب شبانه
  stressLevel          Int?     // 1-5 — سطح استرس روزانه
  waterHabit           Int?     // لیوان در روز — عادت فعلی نوشیدن آب
  targetDate           String?  // ISO date string — تاریخ هدف رسیدن به وزن هدف
  workoutTime          String?  // morning | afternoon | evening | night — ساعت ترجیحی تمرین
  medicalConditions    String?  // JSON array — شرایط پزشکی خاص (دیابت، فشار خون، تیروئید، قلب، ...)
  currentSupplements   String?  // مکمل‌های فعلی مصرفی (متن آزاد)
  dislikedFoods        String?  // غذاهای دوست‌نداشته/حذفی (متن آزاد، با کاما)
  preferredCuisine     String?  // persian | mediterranean | asian | mixed — سبک آشپزی ترجیحی
  // v60 — توضیح آزاد کاربر دربارهٔ شرایط/نیاز/هدف خاص خودش (برای هوش مصنوعی)
  specialConditions    String?

  // v75 — رشتهٔ ورزشی کاربر (classic_physique | bodybuilding | mens_physique |
  // fitness | womens_physique | wellness | bikini_fitness | womens_fitness |
  // powerlifting | crossfit | calisthenics | general) — در آنبوردینگ انتخاب و در
  // پروفایل قابل ویرایش است؛ در تحلیل آنبوردینگ، تولید برنامه (تمرین/غذا/مکمل)،
  // چت با فیتاپ و پروندهٔ ورزشی لحاظ می‌شود.
  discipline           String?

  // Cached AI analysis text from /api/onboarding/analysis (skips regeneration on repeat visits).
  // Pass ?force=1 on the analysis endpoint to bypass the cache and regenerate.
  aiAnalysis           String?

  // v76 — آخرین زمانی که «وزن» پروفایل تغییر کرده (آنبوردینگ یا ویرایش پروفایل).
  // برای حل تعارض دو منبع وزن (پروفایل vs WeightLog): هرکدام جدیدتر باشد مبنای
  // تولید برنامه/چت است. ریشهٔ باگ «وزن ۹۷ در برنامه با پروفایل ۴۶» همین تعارض بود.
  weightUpdatedAt      DateTime?

  // --- NEW: Body composition measurements (BODY-COMPOSITION-PRO) ---
  neckMeasurement      Float?  // cm — for US Navy body fat formula
  shoulderMeasurement  Float?  // cm
  calfMeasurement      Float?  // cm
  // اندازه‌های پایه آنبوردینگ (cm) — onboarding route و checkup fallback این
  // فیلدها را می‌نویسند/می‌خوانند؛ قبل از این مهاجرت در اسکیما غایب بودند و
  // ثبت اندازه‌ها (دور کمر الزایی!) با PrismaClientValidationError شکست می‌خورد.
  chestMeasurement     Float?  // cm
  armMeasurement       Float?  // cm
  waistMeasurement     Float?  // cm — for US Navy body fat formula
  hipMeasurement       Float?  // cm — for US Navy body fat formula (زنان)
  thighMeasurement     Float?  // cm

  // v159 — «تشخیص قطعی ترکیب بدن» (T6 — دیرکتیو مالک): آخرین درصد چربی/عضله
  // قطعی محاسبه‌شده توسط موتور فیتاپ (فرمول اندازه‌های بدنی + سیگنال تعدیلی تحلیل
  // تصویر — هرگز حدس از-همه-عکسِ مدل نمایش داده نمی‌شود). در کارت مشکی داشبورد،
  // پروفایل ورزشی و نمودار پیشرفت نمایش داده می‌شود و با هر چکاپ/تحلیل جدید تازه می‌شود.
  bodyFatPercent    Float?
  musclePercent     Float?
  bodyCompositionAt DateTime?

  // v157 — ممنوعیت‌های ماندگار کاربر/مدیر (ریشه‌یابی تیکت مصطفی خوشبخت):
  // JSON هم‌شکل RedesignConstraints {forbiddenMovements[], forbiddenFoods[],
  // forbiddenSupplements[]} + updatedAt. برخلاف planRegenRequestِ یک‌مصرفی
  // اشتراک، این فیلد «هرگز پاک نمی‌شود و منقضی نمی‌شود» و در «همهٔ» تولیدهای
  // برنامه (خرید/چکاپ/بازطراحی چت/بازنویسی مدیر/به‌روزرسانی وزن) به پرامپت
  // تزریق و پس‌تولیدی ممیزی می‌شود — تا حرکات/غذاهای حذفیِ آسیب‌زا هرگز به
  // برنامه برنگردند. فقط مدیر در پنل می‌تواند آن را اصلاح/پاک کند.
  persistentExclusions Json?

  // v162 — فرم بدن کاربر (انتخاب اجباری آنبوردینگ با تصویر جذاب): pear |
  // inverted_triangle | rectangle | hourglass | oval | athletic — در تحلیل
  // آنبوردینگ، تولید برنامه (اولویت توازن نسبت‌های بدنی)، پروفایل ورزشی و
  // پنل مدیر لحاظ می‌شود.
  bodyShape            String?

  // v162 — عادت دخانیات: none | occasional | daily_light | daily_heavy |
  // quit | prefer_not — در بهینه‌سازی برنامهٔ تمرینی/غذایی (هوازی، ریکاوری،
  // تغذیهٔ آنتی‌اکسیدان) و تحلیل آنبوردینگ لحاظ می‌شود.
  smokingHabit         String?

  // v162 — نواحی آسیب ساختاری (JSON array از InjuryAreaKey) — مکمل متن آزاد
  // injuries؛ تزریق مستقیم به گاردهای ایمنی هوش مصنوعی + جهت‌دهی حرکات توانبخشی.
  injuryAreas          String?

  // v162 — باکس آزاد «سایر مشکلات بدنی/سلامتی» با جزئیات (≤۶۰۰ نویسه) —
  // مستقیم به هوش مصنوعی تزریق می‌شود؛ حرکاتِ در تضاد با آن هرگز تجویز
  // نمی‌شود و حرکت توانبخشی‌محور جایگزین می‌شود.
  otherHealthIssues    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===================== SUBSCRIPTION & PAYMENT =====================
model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   // basic | standard | advanced | ultimate
  // status: active (در حال استفاده) | pending (خرید شده ولی پیش‌نیازها تکمیل نشده) | expired | cancelled
  // برای پلن‌های advanced/ultimate، وقتی کاربر خرید می‌کند اما هنوز عکس بدن/ویدیو/آزمایش خون را
  // آپلود نکرده، اشتراک با status="pending" و startDate/endDate=null ساخته می‌شود.
  // وقتی پیش‌نیازها تکمیل شد (ساخت برنامه در submit-body-analysis)، status به "active" تغییر
  // می‌کند و startDate=now، endDate=now+45day تنظیم می‌شود.
  // ۴۵ روز از زمان تکمیل پیش‌نیازها شروع می‌شود، نه از زمان خرید.
  status        String   @default("active") // active | pending | expired | cancelled
  startDate     DateTime? // null وقتی status=pending
  endDate       DateTime? // null وقتی status=pending
  // تاریخ لغو توسط ادمین — وقتی ادمین اشتراک را لغو می‌کند، این فیلد set می‌شود
  // و endDate اصلی حفظ می‌شود (دیگر overwrite نمی‌شود). برای نمایش بازه واقعی
  // برنامه به کاربر: از startDate تا cancelledAt (اگر لغو شده) یا endDate (اگر منقضی شده).
  cancelledAt   DateTime?
  durationDays  Int      @default(45) // طول دوره
  pricePaid     Int      // مبلغ پرداخت‌شده واقعی (با تخفیف)
  discountCode  String?  // کد تخفیف استفاده‌شده
  paymentId     String?  // شناسه Payment ایجادکننده این اشتراک (برای استرداد دقیق ادمین)
  // ─── v78 — بازطراحی برنامه از چت فیتاپ (درخواست مالک: فقط یکبار در طول اشتراک) ───
  // planRegenUsed: درخواست بازطراحی (تمرین+تغذیه+مکمل) از چت در این اشتراک مصرف شده است.
  // planRegenPending: کاربر نیت تغییر را اعلام کرده؛ دستیار اطلاعات را جمع می‌کند و
  // منتظر تایید نهایی است. بعد از تایید نهایی → planRegenUsed=true و pending=false.
  // هر اشتراک جدید (تمدید/ارتقا) رکورد جدید است → سهمیه «یکبار» به‌طور طبیعی ریست می‌شود.
  planRegenUsed    Boolean  @default(false)
  planRegenPending Boolean  @default(false)
  // ─── v150 — سهمیهٔ اضافهٔ اهدایی مدیر (دیرکتیو مالک: «برای هر کاربر پیشرفته و
  // حرفه‌ای بتونم تعداد انتخابی درخواست تغییر برنامه از چت اضافه کنم») —
  // اعتبارِ هر واحد = یک بازطراحیِ اضافی در همین اشتراک؛ مصرفِ بعدی واحد کم می‌کند. ───
  planRegenExtra   Int      @default(0)
  // ─── v149 — درخواست ساختاری بازطراحی (تیکت مالک: «برنامه عیناً عین درخواست
  // ورزشکار نوشته بشه») — JSON: {spec:{upper,lower,fullBody,push,pull}, raw, at}
  // از متن چت استخراج می‌شود و در تولید برنامه به‌صورت دیرکتیو الزامی تزریق و
  // پس از ذخیرهٔ موفق برنامه مصرف (پاک) می‌شود تا در تولیدهای بعدی نشت نکند. ───
  planRegenRequest String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([cancelledAt])
  // ممیزی 1-f — رسید idempotent verify با paymentId جستجو می‌شود
  @@index([paymentId])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int      // مبلغ نهایی به تومان (با تخفیف)
  originalAmount Int     @default(0) // مبلغ اصلی قبل از تخفیف
  plan          String   // basic | standard | advanced | ultimate
  paymentMethod String   @default("gateway") // gateway | wallet | mixed
  // ─── v202 ممیزی (H6) — @unique: idempotency خرید بازار/دوباره‌verify دیگر
  // فقط به findFirst تکیه ندارد؛ دو ردیف success با یک authority ساختاری
  // ناممکن می‌شود (NULLهای متعدد در SQLite مجاز است — وبِ بدون authority نمی‌شکند).
  authority     String?  @unique // کد مرجع درگاه/زرین‌پال
  refId         String?  // کد پیگیری
  // ممیزی 1-f#7 — وضعیت‌های واقعی کد (claim verifying / reverse reversing /
  // recover expired / legacy manual_resolved) — قبلاً کامنت فقط ۵ تای اول را می‌گفت
  status        String   @default("pending") // pending | verifying | success | failed | cancelled | expired | reversing | refunded | manual_resolved
  discountCode  String?  // کد تخفیف اعمال‌شده
  description   String   @default("")
  cardPan       String?  // شماره کارت ماسک‌شده (از زرین‌پال)
  cardHash      String?  // هش کارت SHA256 (از زرین‌پال)
  fee           Int?     // کارمزد تراکنش (از زرین‌پال)
  // ─── v171 — جریان پرداخت چندمنبعی (سند بازطراحی) ───
  source        String?  // منبع ورود این پرداخت: instagram | app_android | web | unknown
  // URL کال‌بکی که authority فعلی با آن ساخته شده — برای تصمیم «تازه‌سازی
  // authority با کال‌بک درست» در /pay/start و /enter (ضد VPN، چندکلیکی)
  authorityCallbackUrl String?
  // زمان صدور authority فعلی — آستانه ۳دقیقه‌ای تازه‌سازی (هم‌الگوی v124)
  authorityIssuedAt    DateTime?
  createdAt     DateTime @default(now())
  verifiedAt    DateTime?

  authorities   PaymentAuthority[]
  tokens        PaymentToken[]

  @@index([userId])
  @@index([status])
  // ممیزی 1-f#1 — createdAt (حسابداری/کرون) بدون ایندکس بود
  // (ایندکس authority در v202 به @unique روی خود فیلد تبدیل شد)
  @@index([createdAt])
  @@index([source])
}

// ═════════ v171 — سوابق authorityهای صادرشده برای هر پرداخت ═════════
// هر بار که /enter یا /pay/start برای یک پرداخت معلق authority تازه می‌سازد
// (چون کال‌بک قبلی بدون ret= بود یا منقضی/مبهم بود)، authority قبلی اینجا
// ثبت می‌شود تا اگر کاربر روی همان authority قدیمی پرداخت کند (تب بازِ قبلی —
// سناریوی واقعی: کلیک پیامک ← درگاه ← VPN ← کلیک دوباره)، verify با آن هم
// پذیرفته شود و «پول‌داده و گم‌شده» هیچ‌وقت رخ ندهد. وب هرگز ردیفی اینجا
// ندارد → رفتار verify برای وب بایت‌به‌بایت مثل قبل است.
model PaymentAuthority {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  authority String   @unique
  createdAt DateTime @default(now())

  @@index([paymentId])
}

// ═════════ v171 — توکن‌های امن پرداخت (سند بخش ۶) ═════════
// kind="sms_link"  : توکن ۶۴کاراکتری لینک پیامکی اینستاگرام — ۲۰ دقیقه،
//                    گره‌خورده به موبایل + ثبت IP/UA برای ممیزی. چندکلیکی
//                    تا زمان پرداخت موفق (سناریوی VPN: کاربر پیامک را دوباره
//                    می‌زند) — مصرف قطعی فقط با موفقیت پرداخت (lazy).
// kind="app_bridge": پل ۵دقیقه‌ای برای باز کردن Custom Tabs از اپ اختصاصی؛
//                    WebView اپ سشن دارد ولی کروم (Custom Tabs) ندارد.
model PaymentToken {
  id         String    @id @default(cuid())
  token      String    @unique
  kind       String    // sms_link | app_bridge | analysis_discount
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  phone      String?   // شماره گیرنده پیامک (نرمال 09XXXXXXXXX) — فقط sms_link
  amount     Int?      // مبلغ قفل‌شده در لحظه صدور (تومان) — ممیزی
  source     String?   // منبع ورود در لحظه صدور
  ipAddress  String?   // IP لحظه صدور (ممیزی — گره سخت IP ممنوع: VPN تغییرش می‌دهد)
  userAgent  String?
  expiresAt  DateTime
  usedAt     DateTime? // اولین کلیک موفق
  lastClickAt DateTime?
  clickCount Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([paymentId])
  @@index([expiresAt])
  @@index([kind, userId])
}

// ===================== WALLET (کیف پول) =====================
model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // deposit | purchase | refund | bonus
  amount      Int      // مثبت برای افزایش، منفی برای کاهش
  balance     Int      // موجودی پس از تراکنش
  description String   @default("")
  refId       String?  // مرجع (paymentId و ...)
  createdAt   DateTime @default(now())

  @@index([userId])
  // ممیزی 1-f — بازهٔ createdAt (ادمین حسابداری/گزارش‌ها)
  @@index([createdAt])
}

// ===================== DISCOUNT CODES (کد تخفیف) =====================
model DiscountCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // percent | fixed
  value       Int      // درصد یا مبلغ ثابت (تومان)
  maxUses     Int      @default(-1) // -1 = نامحدود
  usedCount   Int      @default(0)
  validFrom   DateTime @default(now())
  validUntil  DateTime?
  active      Boolean  @default(true)
  applicablePlans String @default("all") // all | comma-separated plan ids
  createdAt   DateTime @default(now())
}

// ===================== PROGRAM REQUEST (پس از خرید) =====================
model ProgramRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   // standard | smart | vip
  billingPeriod String   // monthly | yearly
  // ممیزی 1-f#7 — مقادیر واقعی کد: pending_body_photo/pending_generation هم
  // نوشته می‌شوند (payment-delivery/bazaar/submit-body-analysis) ولی در کامنت نبودند
  status        String   @default("pending") // pending | pending_body_photo | pending_generation | generating | ready | failed
  paymentId     String?
  // شمارش تلاش‌های خودترمیم (watchdog) — اگر سرور وسط تولید ری‌استارت شود و
  // تولید یتیم شود، recovery حداکثر یک‌بار خودش تولید را دوباره شروع می‌کند.
  autoRetryCount Int     @default(0)
  // v38 — قابلیت اطمینان تولید: ثبت خطای واقعی + شمارش کل تلاش‌ها (ادمین/سوئیپ خودکار)
  lastError      String?
  attempts       Int     @default(0)
  lastAttemptAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ===================== WORKOUT PLAN =====================
model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekIndex Int      @default(1) // هفته چندم برنامه
  content   String   // JSON: full weekly workout plan
  active    Boolean  @default(true)
  // v76 — وزن مبنا هنگام تولید این برنامه (kg)؛ برای تشخیص ناسازگاری وزن
  // (کاربر وزن را اصلاح کرده ولی برنامه با وزن قدیمی است) و نمایش بنر هشدار.
  baseWeight Float?
  // v111 — نسخه‌بندی برنامه: هر بازتولید نسخهٔ جدید می‌سازد و نسخهٔ قبلی
  // با تاریخ شروع/اصلاح در تاریخچه (تب برنامه‌ها و پنل مدیر) می‌ماند.
  version         Int       @default(1) // شماره نسخه (۱ = اولین برنامه)
  generatedSource String?   // purchase | checkup | admin_rewrite | chat_request | weight_update
  changeSummary   String?   // خلاصهٔ تغییرات این نسخه نسبت به قبلی (مثلاً درخواست کاربر در چت)
  supersededAt    DateTime? // زمانی که این نسخه با نسخهٔ جدیدتری جایگزین شد (= تاریخ اصلاح)
  supersededById  String?   // شناسهٔ نسخهٔ جایگزین‌شده
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ===================== MEAL PLAN =====================
model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayLabel  String   @default("today") // which day
  content   String   // JSON: meals with calories & macros
  totalCal  Int      @default(0)
  active    Boolean  @default(true)
  // v76 — وزن مبنا هنگام تولید (kg) — تشخیص ناسازگاری وزن (بند باگ وزن ۹۷/۴۶)
  baseWeight Float?
  // v111 — نسخه‌بندی (قرینهٔ WorkoutPlan)
  version         Int       @default(1)
  generatedSource String?   // purchase | checkup | admin_rewrite | chat_request | weight_update
  changeSummary   String?
  supersededAt    DateTime?
  supersededById  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ===================== EXERCISE LIBRARY (Admin) =====================
model ExerciseLibrary {
  id          String   @id @default(cuid())
  name        String   // نام حرکت
  muscle      String   // عضله هدف
  category    String   // push | pull | legs | core | cardio | fullbody
  equipment   String   @default("") // تجهیزات لازم
  description String   @default("") // توضیحات نحوه انجام
  tips        String   @default("") // نکات ایمنی
  mediaUrl    String   @default("") // URL انیمیشن/ویدیو
  youtubeUrl  String   @default("") // URL امبد یوتیوب (https://www.youtube.com/embed/VIDEO_ID)
  // v111 — ویدیوی اختصاصی آپلودی مدیر (/uploads/exercise-videos/...) — در نمایش
  // همه‌جا اولویت بالاتری از youtubeUrl دارد؛ یوتیوب فقط fallback است.
  videoUrl       String @default("") // مسیر ویدیوی اختصاصی
  videoSizeBytes Int    @default(0)  // حجم فایل ویدیوی اختصاصی (بایت) — نمایش در پنل
  videoPosterUrl String @default("") // فریم شاخص ویدیو (poster)
  // v113 — کلید یوتیوبِ تک‌حرکتی (پنل ادمین): فقط وقتی videoUrl (اختصاصی) آپلود
  // شده معنا پیدا می‌کند — خاموش = فقط ویدیوی اختصاصی نشان داده می‌شود و یوتیوب پنهان است.
  // (نمایش نهایی = کلید سراسری exercise_youtube_enabled ∧ همین فیلد ∧ وجود youtubeUrl)
  youtubeEnabled Boolean @default(true)
  // v189 — ویدیوی Muscle Wiki (دانلود و فشرده‌شده — /videos/exercises/<id>.mp4):
  // اولویت نمایش = videoUrl (اختصاصی ادمین) > mwVideoUrl/mwVideoUrlFemale > youtubeUrl.
  // یوتیوب فقط برای حرکاتی می‌ماند که نه ویدیوی اختصاصی دارند نه ویدیوی Muscle Wiki.
  mwVideoUrl       String @default("") // ویدیوی Muscle Wiki — مرد (fallback پیش‌فرض)
  mwVideoUrlFemale String @default("") // ویدیوی Muscle Wiki — زن (خالی = همان مرد)
  // v190 — کلید تک‌حرکتی Muscle Wiki (پنل ادمین — مثل youtubeEnabled):
  // خاموش = ویدیوی Muscle Wikiِ فقط همین حرکت پنهان است → نمایش به اختصاصی یا
  // یوتیوب برمی‌گردد. (نمایش نهایی MW = کلید سراسری exercise_musclewiki_enabled ∧ همین فیلد ∧ وجود mwVideoUrl)
  mwEnabled Boolean @default(true)
  difficulty  String   @default("intermediate") // beginner | intermediate | advanced
  // v135 — کلید فعال/غیرفعال (پنل ادمین): غیرفعال = از همهٔ لیست‌های عمومی
  // (بانک، API عمومی، sitemap، رشته‌ها، پرامپت AI) حذف می‌شود؛ صفحهٔ /exercise/[id]
  // به‌جای ۴۰۴ یک صفحهٔ لطیف noindex «غیرفعال» نشان می‌دهد — هیچ لینک شکسته‌ای.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================== FOOD LIBRARY (Admin) =====================
model FoodLibrary {
  id          String   @id @default(cuid())
  name        String   // نام غذا
  category    String   // breakfast | lunch | dinner | snack
  calories    Int      // کالری در هر وعده
  protein     Float    @default(0) // گرم پروتئین
  carbs       Float    @default(0) // گرم کربوهیدرات
  fat         Float    @default(0) // گرم چربی
  servingSize String   @default("۱ وعده") // اندازه وعده
  imageUrl    String   @default("")
  isVegan     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================== FOOD LOG (غذاهای ثبت‌شده روزانه کاربر) =====================
// هر رکورد = یک غذای ثبت‌شده در یک وعده از یک روز مشخص برای کاربر.
// منبع ممکن است: انتخاب از FoodLibrary، ورود دستی، یا تحلیل عکس غذا (AI) باشد.
model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // اطلاعات غذا (denormalized — حتی اگر FoodLibrary تغییر کرد، ثبت تاریخی دست‌نخورده می‌ماند)
  name        String                       // نام غذا
  meal        String   @default("snack")   // breakfast | lunch | dinner | snack
  calories    Int      @default(0)         // کالری این وعده
  protein     Float    @default(0)         // گرم پروتئین
  carbs       Float    @default(0)         // گرم کربوهیدرات
  fat         Float    @default(0)         // گرم چربی
  servingSize String   @default("۱ وعده")  // اندازه/تعداد وعده (مثلاً "۱.۵ وعده" یا "۲۰۰ گرم")

  // منبع غذا — برای تفکیک گزارش‌ها
  source      String   @default("manual")  // manual | library | ai_photo
  foodLibraryId String?                     // اگر از بانک غذاها انتخاب شده، شناسه آن
  imageUrl    String?                       // اگر از تحلیل عکس غذا آمده، URL عکس آپلودشده

  // تاریخ ثبت — تاریخ «روز» جداگانه نگه داشته می‌شود تا فیلتر کردن روزانه سریع باشد
  logDate     DateTime @default(now())     // تاریخ دقیق ثبت
  day         DateTime @default(now())     // شروع روز میلادی (برای group-by روزانه)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, day])
  // ممیزی 1-f#2 — canAccessPrivateMedia با imageUrl فول‌اسکن می‌زد
  @@index([imageUrl])
}

// ===================== PROGRESS TRACKING =====================
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float    // kg
  note      String   @default("")
  loggedAt  DateTime @default(now())

  @@index([userId])
}

// وضعیت روزانه تمرین — برای مدیریت انعطاف‌پذیر روزهای تمرین/استراحت
// اگر کاربر روزی را تمرین کرد یا جابجا کرد، یک رکورد در این جدول ذخیره می‌شود
model WorkoutDayStatus {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // روز هفته (شنبه، یکشنبه، ...)
  dayName     String
  // تاریخ دقیق آن روز (برای جلوگیری از تکرار در هفته‌های مختلف)
  weekStart   DateTime // تاریخ شروع هفته (شنبه آن هفته)
  // وضعیت: completed (تمرین انجام شد) | skipped (جابجا شد) | rest_as_planned (استراحت طبق برنامه)
  status      String   @default("completed")
  // اگر جابجا شد، به کدام روز منتقل شد
  movedTo     String?
  // چه روزی به‌جای آن تمرین شد (اگر روز استراحت را با تمرین جایگزین کرد)
  swappedFrom String?
  createdAt   DateTime @default(now())

  @@unique([userId, dayName, weekStart])
  @@index([userId])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String
  type      String   // front | side | back | checkup (v159 — عکس‌های پیوستِ چکاپ)
  note      String   @default("")
  takenAt   DateTime @default(now())
  // v159 (T5) — شناسهٔ چکاپِ مرتبط (فقط برای type="checkup") — بدون رابطه؛
  // گالری پیشرفت (تب «چکاپ») با همین شناسه تحلیلِ چکاپ را به عکس‌ها می‌چسباند.
  checkupId String?

  @@index([checkupId])
  @@index([userId])
  // ممیزی 1-f#2 — canAccessPrivateMedia با imageUrl فول‌اسکن می‌زد
  @@index([imageUrl])
}

// ===================== v215 — لاگ ماندگار ست‌های تمرینی =====================
// دیرکتیو مالک: «تمام تمرینات و وزنه‌هایی که کاربر ثبت می‌کنه در برنامه‌های بعدی
// خیلی ریز وارد بشه». تا v215 وزنهٔ هر ست فقط در localStorage (۳ روز!) می‌ماند
// و «پیشرفت قدرتی هر حرکت» (اسکوات ۶۰→۸۰kg) برای AI اساساً غیرقابل‌محاسبه بود.
// حالا هر ثبت ست/وزنه/تکرار از «تمرین امروز» یا «حالت باشگاه» با سینک بی‌صدا
// به اینجا می‌آید تا پروندهٔ ورزشی، روند وزنهٔ هر حرکت را ریز گزارش کند.
model WorkoutSetLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // تاریخ تهران YYYY-MM-DD + نام روز برنامه (شنبه/یکشنبه/...) — همان کلید مشترک دو نما
  dateKey      String
  dayName      String
  // شناسهٔ حرکت در برنامه — کلید ثبت کلاینت `${exerciseId}_${setNumber}`
  exerciseId   String
  // نام نمایشی حرکت — سمت سرور از برنامهٔ فعال resolve می‌شود (برای پروندهٔ AI)
  exerciseName String?
  setNumber    Int
  weightKg     Float?
  reps         Int?
  done         Boolean  @default(false)
  // gym_mode | today_workout
  source       String
  updatedAt    DateTime @default(now())

  @@unique([userId, dateKey, exerciseId, setNumber])
  @@index([userId, dateKey])
  @@index([userId, exerciseId])
  @@index([userId, updatedAt])
}

// ===================== BODY COMPOSITION (T6 — تشخیص قطعی ترکیب بدن) =====================
// تاریخچهٔ درصد چربی/عضلهٔ بدن — هر رکورد یک «نقطهٔ قطعی» روی نمودار رشد است.
//  • source="initial"       → اولین تشخیص (آنبوردینگ یا اولین تحلیل بدن)
//  • source="body_analysis" → تحلیل عکس بدن (پیشرفته/حرفه‌ای)
//  • source="checkup"       → چکاپ دوره‌ای (استاندارد به بالا)
// کاربران اقتصادی فقط نقطهٔ initial را دارند (چکاپ/تحلیل بدن قفل است) —
// کاربران استاندارد+ با هر چکاپ نقطهٔ تازه می‌گیرند و نمودار همیشه رشد را نشان می‌دهد.
model BodyComposition {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fatPercent    Float
  musclePercent Float?
  source        String   // "initial" | "checkup" | "body_analysis"
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ===================== AI CHAT (مربی هوشمند) =====================
model ChatMessage {
  clientId      String?  @unique // v73.3 — کلید یکتای کلاینت برای جلوگیری از پیام تکراری (دبل‌سند/رفرش)
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   // user | assistant
  content       String
  mediaUrl      String?  // URL فایل مدیا (عکس/ویدیو) ارسال‌شده توسط کاربر
  mediaType     String?  // image | video — نوع مدیا
  mediaFrames   String?  // v70 — JSON آرایه URL فریم‌های استخراج‌شده ویدیو (برای سینک مدیا در پیام‌های بعدی)
  mediaAnalysis String?  // v71 — تحلیل متنی رسانه توسط جمنای (فقط یک‌بار تولید و کش می‌شود؛ پیام‌های متنی بعدی با همین تحلیل توسط دیپ‌سیک سینک می‌مانند)
  programCycle  String?  // شناسه دوره برنامه (برای تفکیک تاریخچه بر اساس هر دوره)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([programCycle])
  // ممیزی 1-f#2/#3 — سرو مدیا خصوصی (mediaUrl) + تحلیل هوشمند/تاریخچه (createdAt)
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([mediaUrl])
}

// ===================== NIKA CHAT (دستیار فروش) =====================
model NikaMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===================== NOTIFICATIONS =====================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // welcome | workout_reminder | water_reminder | subscription | achievement | system | upgrade | renewal | re_engagement | checkup | coach
  title     String
  body      String
  link      String?  // internal app path for clickable notifications (e.g. "?tab=plans")
  meta      String?  // JSON string for extra data
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  // ─── v202 ممیزی (L12) — کوئری داغ لیست اعلان‌ها (userId + read + orderBy createdAt)
  @@index([userId, read, createdAt])
}

// ===================== v178 — کمپین‌های اعلان مدیر (هدف‌گیری + زمان‌بندی) =====================
// هر ردیف یک «کمپین اعلان» است: مدیر گیرندگان (segment — JSON) را انتخاب می‌کند و
// یا فوراً ارسال می‌کند یا برای زمان آینده زمان‌بندی می‌کند. جاروی داخلی
// instrumentation (هر ۶۰ ثانیه) کمپین‌های سررسیده را dispatch می‌کند.
// segment نمونه: {"kind":"all"} | {"kind":"active_plan"} | {"kind":"plan","plan":"basic"}
//   | {"kind":"source","source":"instagram"} | {"kind":"app","app":"bazaar"}
//   | {"kind":"registered","from":"...","to":"..."} | {"kind":"purchased","from","to"}
//   | {"kind":"never_purchased"} | {"kind":"expiring","from","to"} | {"kind":"users","ids":[..]}
model NotificationCampaign {
  id           String    @id @default(cuid())
  title        String
  body         String
  type         String    @default("system") // همان enum مدل Notification
  link         String?
  segment      String    // JSON مشخصات هدف‌گیری
  status       String    @default("draft") // draft | scheduled | sending | sent | failed | canceled
  scheduledAt  DateTime? // برای کمپین‌های زمان‌بندی‌شده
  sentAt       DateTime?
  totalTargets Int       @default(0)
  sentCount    Int       @default(0)
  pushCount    Int       @default(0)
  error        String?
  createdBy    String?   // userId ادمین سازنده
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

// ===================== AI CONFIG (Admin) =====================
model AiConfig {
  id            String   @id @default(cuid())
  key           String   @unique // coach_system_prompt | chat_system_prompt | nutrition_system_prompt
  value         String   // long text
  label         String   @default("")
  updatedAt     DateTime @updatedAt
}

// ===================== ARTICLES (CMS) =====================
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  content     String   // Markdown/HTML content with code blocks
  category    String   @default("general") // general | nutrition | training | motivation | news
  tags        String   @default("")
  status      String   @default("draft") // draft | published
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  revisions   ArticleRevision[]
  coverImage  String   @default("")
  // SEO fields (برای سئوی حرفه‌ای)
  seoTitle        String   @default("")
  seoDescription  String   @default("")
  metaKeywords    String   @default("")
  canonicalUrl    String   @default("")
  ogImage         String   @default("")
  robots          String   @default("index,follow") // index,follow | noindex,nofollow
  readingMinutes  Int      @default(3)
  // Scheduled publishing: اگر تنظیم شود، مقاله در زمان مشخص‌شده توسط cron انتشار، منتشر می‌شود.
  // فقط برای مقالاتی که status="draft" است معتبر است.
  scheduledAt     DateTime?
  // تاریخ انتشار واقعی مقاله — زمانی که مقاله از draft به published تبدیل می‌شود.
  // این تاریخ برای نمایش به کاربر و JSON-LD datePublished استفاده می‌شود (نه createdAt).
  // برای مقالات قدیمی که قبلاً منتشر شده‌اند، با createdAt backfill می‌شود.
  publishedAt     DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([scheduledAt])
  @@index([publishedAt])
}

// نسخه پشتیبان محتوای مقاله قبل از بازنویسی هوشمند (قابل بازیابی توسط ادمین)
model ArticleRevision {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title       String?
  excerpt     String?
  content     String
  seoTitle    String?
  seoDescription String?
  metaKeywords String?
  createdAt   DateTime @default(now())

  @@index([articleId])
}

// ===================== SITE SETTINGS (CMS) =====================
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String   @default("")
  updatedAt DateTime @updatedAt
}

// ===================== TERMS & CONDITIONS =====================
model TermsVersion {
  id        String   @id @default(cuid())
  version   Int      @default(1)
  // نوع سند: "terms" = شرایط و قوانین | "privacy" = حریم خصوصی
  // (هر کدام شماره نسخه مستقل خودشان را دارند)
  slug      String   @default("terms")
  title     String   @default("شرایط و قوانین فیتاپ")
  content   String   // Full markdown/HTML content
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, isActive])
}

// ===================== HEAD CODE INJECTION (Analytics / Search Console / Pixels) =====================
model HeadCode {
  id        String   @id @default(cuid())
  name      String   // e.g. "Google Analytics", "Search Console", "Meta Pixel"
  type      String   // "analytics" | "search_console" | "pixel" | "custom"
  code      String   // The raw HTML/script tag to inject
  placement String   @default("head") // "head" | "body_start" | "body_end"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== CHECKUP (چکاپ دوره‌ای) =====================
model Checkup {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phaseNumber     Int      // which phase (1, 2, 3)
  isFinalCheckup  Boolean  @default(false)
  status          String   @default("pending_coach") // pending_coach | completed

  // Athlete submission
  weight          Float
  chestMeasurement Float?  // cm
  armMeasurement  Float?   // cm
  waistMeasurement Float?  // cm
  hipMeasurement   Float?  // cm
  thighMeasurement Float?  // cm
  neckMeasurement  Float?  // cm — for US Navy body fat formula

  // Calculated biometrics (computed locally)
  bodyFatPercent  Float?
  leanBodyMass    Float?

  // Feedback
  fatigueLevel    Int      @default(3) // 1-5
  sleepQuality    Int      @default(3) // 1-5
  dietAdherence   Int      @default(3) // 1-5
  workoutAdherence Int     @default(3) // 1-5
  phaseCompleted  Boolean  @default(false)
  notes           String   @default("")

  // AI Analysis (stored after AI processes)
  aiAnalysis      String?  // JSON string with bodyScore, analysis, recommendations

  // Coach notes (for plans with human oversight)
  coachNotes      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ===================== PER-USER DISCOUNT CODES (تخفیف اختصاصی تمدید) =====================
model UserDiscountCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String   @unique
  type        String   // "percent" | "fixed"
  value       Int
  reason      String   @default("renewal_loyalty")
  isUsed      Boolean  @default(false)
  validUntil  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ===================== SMS LOG (لاگ پیامک‌های سیستمی — دداپ/گزارش) =====================
// هر پیامک سیستمی (به‌جز OTP و تیکت) قبل از ارسال با (mobile, key) چک می‌شود
// تا هر سناریو «فقط یک بار در عمر حساب» ارسال شود — حتی بعد از backfill دیپلوی.
model SmsLog {
  id          String   @id @default(cuid())
  mobile      String   // گیرنده (نرمال‌شده 9XXXXXXXXX)
  key         String   // کلید سناریو: onboarding_nudge | onboarding_winback | program_ready | checkup_reminder | plan_expired | invite_friend | expired_winback
  templateId  String   // کد قالب sms.ir که استفاده شد
  userId      String?  // کاربر مرتبط (در صورت وجود)
  status      String   // sent | failed | skipped | queued (v217 — صف صبح ترک-درگاه؛ با upsert ارسال به sent ارتقا می‌یابد)
  error       String?  // متن خطا در صورت failed
  createdAt   DateTime @default(now())

  @@unique([mobile, key])
  @@index([key, createdAt])
}

// ===================== SMS SHORT LINKS (v48 — سقف ۲۵ کاراکتری پارامتر sms.ir) =====================
// پارامترهای قالب sms.ir حداکثر ۲۵ کاراکتر مجازند (خطای 114). لینک تمدید کامل
// (go/renew?t=JWT) صدها کاراکتر است → نگاشت کد کوتاه یکتا به مقصد واقعی.
// پیامک LINK = «r/XXXXXXXX» و /r/[code] به /go/renew?t=… ریدایرکت می‌کند
// (لینک هوشمند اپ حفظ می‌شود).
model SmsShortLink {
  id        String   @id @default(cuid())
  code      String   @unique // کد کوتاه ۸ کاراکتری — در پیامک: r/{code}
  target    String   // مقصد نسبی واقعی (مثلاً go/renew?t=...)
  userId    String?  // کاربر مرتبط (تحلیل/ردیابی)
  expiresAt DateTime? // انقضای اختیاری — بعد از آن ریدایرکت به صفحهٔ اصلی
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ===================== تحلیل هوشمند پلن (v48 — یک‌بار در هر پلن) =====================
// «دکمهٔ تحلیل هوشمند» در منوی برنامه‌ها باید در هر پلن فقط یک‌بار تولید شود؛
// تا پایان همان پلن، متن ذخیره‌شده به‌صورت آکاردئون نمایش داده می‌شود.
// planKey = شناسهٔ برنامهٔ تمرینی فعال (با پلن/بازسازی جدید، کلید عوض می‌شود).
model PlanAiAnalysis {
  id        String   @id @default(cuid())
  userId    String
  planKey   String   // شناسهٔ چرخهٔ پلن (WorkoutPlan.id فعال)
  content   String   // متن تحلیل تولیدشده
  model     String?  // مدل AI که تولید کرده (شفافیت هزینه)
  createdAt DateTime @default(now())

  @@unique([userId, planKey])
  @@index([userId, createdAt])
}

// ===================== OTP CODES (SMS OTP Login) =====================
model OtpCode {
  id        String   @id @default(cuid())
  mobile    String   // شماره موبایل (11 رقمی)
  code      String   // کد ۴ رقمی
  expiresAt DateTime // زمان انقضا (۱۰ دقیقه — پیامک‌رسان‌ها گاهی دیر می‌رسند)
  used      Boolean  @default(false) // آیا استفاده شده؟
  attempts Int      @default(0) // تعداد تلاش‌های ناموفق verify (ضد brute-force)
  createdAt DateTime @default(now())

  @@index([mobile])
}

// ===================== SEO AGENT (ایجنت سئو خودکار) =====================
// استراتژی سئوی ذخیره‌شده — بعد از هر اجرای موفق آپدیت می‌شود
model SeoStrategy {
  id              String   @id @default(cuid())
  version         Int      @default(1) // نسخه استراتژی
  isActive        Boolean  @default(true)
  // JSON کامل شامل: contentPillars, targetKeywords, clusters, contentCalendar, internalLinkMap
  content         String
  // خلاصه قابل نمایش در UI
  summary         String   @default("")
  // کلمات کلیدی هدف (comma-separated)
  targetKeywords  String   @default("")
  // صفحات و مقالات موجود در سایت (JSON) — برای لینک‌سازی دقیق
  siteMap         String   @default("[]")
  // تعداد مقالات برنامه‌ریزی‌شده
  plannedCount    Int      @default(0)
  // تنظیمات خودکارسازی
  autoMode        Boolean  @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// صف مقالات برنامه‌ریزی‌شده توسط ایجنت سئو
model SeoArticlePlan {
  id              String   @id @default(cuid())
  // کلمه کلیدی هدف
  keyword         String
  // عنوان پیشنهادی مقاله
  title           String
  // slug پیشنهادی (انگلیسی)
  slug            String   @default("")
  // دسته‌بندی: training | nutrition | motivation | general | supplement | recovery
  category        String   @default("general")
  // خلاصه کوتاه
  excerpt         String   @default("")
  // pillar — کلاستر محتوایی که این مقاله به آن تعلق دارد
  pillar          String   @default("")
  // کلمات کلیدی ثانویه (comma-separated)
  secondaryKeywords String @default("")
  // لینک‌های داخلی پیشنهادی (JSON: [{slug, title, anchor}])
  internalLinks   String   @default("[]")
  // prompt پیشنهادی برای تصویر کاور
  coverImagePrompt String  @default("")
  // پرامپت‌های پیشنهادی برای تصاویر داخل مقاله (JSON array of strings)
  inlineImagePrompts String @default("[]")
  // وضعیت: planned | queued | generating | published | failed | skipped
  status          String   @default("planned")
  // شناسه مقاله ساخته‌شده (بعد از انتشار)
  articleId       String?
  // اولویت (هرچه بالاتر، زودتر تولید می‌شود)
  priority        Int      @default(50)
  // دلیل شکست (در صورت failed)
  errorMessage    String?
  // تعداد دفعات تلاش
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([pillar])
  @@index([keyword])
}

// لاگ اجرای ایجنت سئو — هر بار اجرا یک رکورد
model SeoAgentRun {
  id              String   @id @default(cuid())
  // نوع اجرا: full (استراتژی + تولید) | continue (ادامه تولید) | strategy_only | analyze_only | content_refresh (آپدیت محتوا از سرچ کنسول)
  mode            String   @default("full")
  status          String   @default("running") // running | completed | failed | partial
  // تعداد مقالات درخواستی
  requestedCount  Int      @default(5)
  // تعداد مقالات موفق
  successCount    Int      @default(0)
  // تعداد خطاها
  failCount       Int      @default(0)
  // لاگ‌های اجرا (JSON array of {ts, level, msg})
  logs            String   @default("[]")
  // خلاصه نتایج (JSON)
  results         String   @default("{}")
  // مدت زمان اجرا (ms)
  durationMs      Int      @default(0)
  startedAt       DateTime @default(now())
  finishedAt      DateTime?

  @@index([status])
  @@index([startedAt])
}

// ===================== FEEDBACK (پیشنهادات و انتقادات) =====================
model Feedback {
  id        String   @id @default(cuid())
  message   String
  category  String   @default("suggestion") // suggestion | complaint | bug | other
  name      String?
  mobile    String?
  userId    String?
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([reviewed])
  // ─── v202 ممیزی (L12) — ایندکس userId برای پاک‌سازی/جست‌وجوی ادمین
  @@index([userId])
}

// ===================== PUSH SUBSCRIPTION (نوتیفیکیشن موبایل) =====================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  // ممیزی 1-f#8 — رابطهٔ واقعی به User با Cascade؛ قبلاً ستون بدون FK بود و
  // حذف کاربر اشتراک پوش را یتیم می‌کرد (ارسال مداوم به endpointهای مرده)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // URL پوش سرور (FCM/Apple/etc)
  p256dh    String   // کلید عمومی
  auth      String   // کلید احراز هویت
  userAgent String?  // نوع مرورگر/دستگاه
  // v63 — شناسهٔ پایدار مرورگر/دستگاه (localStorage) برای تضمین «هر دستگاه =
  // حداکثر یک اشتراک»؛ ریشهٔ نوتیف‌های تکراری (۲-۵×) انباشت endpointهای
  // قدیمی FCM بود. کلاینت‌های جدید این را می‌فرستند؛ ردیف‌های قدیمی null.
  deviceId  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── v78 — توکن FCM اپ اندروید (نوتیف در حالت بسته بودن کامل اپ) ───
// درخواست مالک: «وقتی اپ موبایل کلا از گوشی بسته است نوتیف‌ها ارسال نشده —
// چندبار تاکید کردم که باید ارسال شود». اپ اندروید (WebView shell) توکن FCM
// را بعد از اولین اجرا به این جدول می‌فرستد؛ سرور در createNotification به
// همهٔ توکن‌های فعال کاربر push می‌زند (FCM وقتی اپ بسته است هم می‌رسد).
// fallback: WorkManager اپ (هر ۱۵ دقیقه) بدون FCM هم کار می‌کند.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // FCM registration token
  platform  String   @default("android") // android | ios | web
  userAgent String?
  // آخرین باری که اپ با این توکن آنلاین بود — توکن‌های خیلی قدیمی هنگام خطای
  // Unregistered/InvalidRegistration از FCM حذف (purge) می‌شوند
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===================== SURVEY (نظرسنجی پایان پلن) =====================
// نظرسنجی که بعد از اتمام پلن به کاربر نشان داده می‌شود.
// شامل سوالات عمومی + سوالات اختصاصی پلن + نمرات ۱ تا ۵ + کامنت کلی.
// ratings به‌صورت JSON ذخیره می‌شود: { questionId: number }
// 例: { "overall_coach_quality": 5, "program_effectiveness": 4, "support_quality": 5 }
model Survey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // نام پلنی که کاربر در زمان تکمیل نظرسنجی از آن استفاده می‌کرده
  planName  String   // basic | standard | advanced | ultimate
  // نمرات به‌صورت JSON: { questionId: 1..5 }
  ratings   String   // JSON string
  // کامنت کلی کاربر (متن آزاد)
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([planName])
  @@index([createdAt])
}

// ===================== USER ADMIN NOTES (توضیحات مدیر) =====================
// یادداشت‌های پایدار ادمین درباره هر کاربر (مثلاً محتوای تماس تلفنی) —
// همیشه ذخیره می‌مانند تا سال‌ها بعد هم تاریخچه قابل مرور باشد.
model UserAdminNote {
  id        String   @id @default(cuid())
  userId    String
  body      String   // متن یادداشت
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorMobile String? // شماره ادمینی که نوشته (برای مرجع)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ===================== OWN ANDROID APP RELEASES (اپ اختصاصی فیتاپ) =====================
// نسخه‌های اپ اندروید «اختصاصی» فیتاپ (WebView پنل کاربری) که فقط از خود سایت
// دانلود می‌شود (نه کافه‌بازار). اپ در هر اجرا /api/app/own/latest را صدا می‌زند؛
// اگر versionCode اپ < آخرین نسخه → مودال زیبای آپدیت (changelog + دکمه دانلود).
// فایل APK در uploads/apk/ ذخیره و از /api/app/own/download سرو می‌شود.
model OwnAppRelease {
  id          String   @id @default(cuid())
  versionName String            // نام نسخه نمایشی — مثلاً "1.0.0"
  versionCode Int               // کد نسخه صحیح صعودی — مثلاً 1
  changelog   String   @default("") // تغییرات نسخه (متن فارسی، چندخطی)
  fileName    String            // نام فایل ذخیره‌شده در uploads/apk
  fileSize    Int      @default(0) // حجم فایل (بایت)
  downloads   Int      @default(0) // تعداد دانلود (آمار داخلی)
  forceUpdate Boolean  @default(false) // آپدیت اجباری برای نسخه‌های قدیمی‌تر؟
  isActive    Boolean  @default(true)  // قابل عرضه است؟
  createdAt   DateTime @default(now())

  @@index([versionCode])
  @@index([createdAt])
}

// ===================== SMS MESSAGE LOG v52 (لاگ تک‌تک پیامک‌ها + هزینه) =====================
// برخلاف SmsLog (ردیف دداپ per mobile+key)، این جدول «هر ارسال واقعی» را با
// هزینه‌ای که sms.ir برمی‌گرداند ثبت می‌کند تا حسابداری بتواند هزینهٔ دقیق
// پیامک‌ها را (ریزش per-scenario) محاسبه کند. OTP و تیکت هم اینجا لاگ می‌شوند.
// اگر sms.ir هزینه برنگرداند (خطا/سندباکس)، cost با نرخ پیش‌فرض تنظیمات پر می‌شود.
model SmsMessageLog {
  id         String   @id @default(cuid())
  mobile     String   // گیرنده (نرمال‌شده)
  scenario   String   // otp | ticket_reply | ticket_created | onboarding_nudge | program_ready | ... | custom
  templateId String?  // کد قالب sms.ir (در صورت استفاده از قالب)
  provider   String   @default("smsir")
  status     String   // sent | failed
  cost       Int      @default(0) // هزینه به تومان (از پاسخ sms.ir یا نرخ پیش‌فرض)
  error      String?  // متن خطا در صورت failed
  userId     String?  // کاربر مرتبط (در صورت وجود)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([scenario, createdAt])
  @@index([status, createdAt])
}

// ===================== AI USAGE LOG v52 (لاگ مصرف API هوش مصنوعی + هزینه) =====================
// هر فراخوانی موفق LLM/تصویر/TTS یک ردیف می‌گیرد تا حسابداری بتواند هزینهٔ
// API را (بر اساس قیمت دلاری هر مدل × نرخ دلار روز) با ریز per-model و
// per-route محاسبه کند. نوشتن لاگ best-effort است و هرگز جریان اصلی را نمی‌شکند.
model AiUsageLog {
  id               String   @id @default(cuid())
  route            String   // شناسه مسیر/مصرف‌کننده — مثلاً coach:plan | coach:chat | admin:accounting-analyze
  model            String   // مدل استفاده‌شده (بعد از fallback نهایی)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0) // هزینهٔ برآوردی به دلار (قیمت جدول مدل‌ها)
  costToman        Int      @default(0) // همان هزینه به تومان با نرخ دلار لحظهٔ ثبت
  latencyMs        Int?     // مدت پاسخ (اختیاری — برای سلامت سرویس)
  userId           String?  // کاربر مرتبط (در صورت وجود)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([model, createdAt])
  @@index([route, createdAt])
}

// ===================== DAY COMPLETION v52 (وضعیت روز — باشگاه ↔ تامین امروز) =====================
// منبع واحد حقیقت برای «روز کامل»: کاربر هم تمرینش را ثبت کند و هم تغذیه‌اش را
// در ریل هدف باشد → مدال روز در هر دو بخش (حالت باشگاه و کالری‌شمار/تامین امروز)
// و داشبورد نمایش داده می‌شود. ثبت در هر یک، خودکار در دیگری دیده می‌شود.
// date = YYYY-MM-DD به وقت تهران (تهران-نیمه‌شب) — همیشه با helper مشترک ساخته شود.
model DayCompletion {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String    // YYYY-MM-DD به وقت تهران
  workoutDone    Boolean   @default(false)
  workoutSource  String?   // gym_mode | guided_session
  workoutAt      DateTime?
  nutritionDone  Boolean   @default(false)
  nutritionAt    DateTime?
  medalSeenAt    DateTime? // اولین نمایش مدال جشن (برای یک‌بار-in-the-day بودن)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ===================== QUOTA USAGE v53 (سهمیهٔ مصرف رسانه‌ها در پلن جاری) =====================
// سهمیه‌های پلن: عکس چت با فیتاپ (۹۰ در دوره + ۲ در روز)، تحلیل عکس غذا (به تعداد
// روزهای پلن — پیش‌فرض ۴۵)، آنالیز ویدیو حرکات (به تعداد حرکات برنامهٔ جاری).
// مدیر می‌تواند سهمیهٔ اضافه (bonus) بدهد؛ با شروع/تمدید پلنِ جدید صفر می‌شود
// (تشخیص با periodStart = planStartedAt لحظهٔ آخرین مصرف).
model QuotaUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // chat_photo | meal_photo | movement_video
  used        Int      @default(0) // مصرف دورهٔ جاری
  bonus       Int      @default(0) // سهمیهٔ اضافه‌ای که ادمین داده
  dailyUsed   Int      @default(0) // مصرف امروز (فقط برای سهمیه‌های روزانه مثل chat_photo)
  dailyKey    String?  // کلید روز تهران (YYYY-MM-DD) که dailyUsed به آن تعلق دارد
  periodStart DateTime? // planStartedAt در لحظهٔ شمارش — تغییرش یعنی ریست دوره
  updatedAt   DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// ===================== SMART ANALYSIS REPORT v53 (تحلیل هوشمند صبحگاهی سایت) =====================
// گزارش روزانهٔ ساعت ۶ صبح تهران + تحلیل روی‌تقاضا برای بازه‌های
// ۱روز/۱هفته/۱ماه/۳ماه/۶ماه/۱سال — فروش، نرخ تبدیل، سئو، سود خالص، سهمیه‌ها.
// payload = فکت‌های ساختاریافتهٔ سایت | report = متن مارک‌داون AI | actions = پیشنهادهای قابل‌اجرا
model SmartAnalysisReport {
  id          String   @id @default(cuid())
  range       String   // 1d | 7d | 30d | 90d | 180d | 365d
  rangeStart  DateTime
  rangeEnd    DateTime
  payload     String   @default("{}") // JSON فکت‌های سایت
  report      String   @default("") // متن تحلیل مارک‌داون فارسی
  actions     String?  // JSON اکشن‌های پیشنهادی (کلاستر سئو، تنظیم سهمیه و…)
  healthScore Int?     // امتیاز سلامت ۰-۱۰۰ (در صورت تولید)
  trigger     String   @default("manual") // daily_cron | manual
  createdAt   DateTime @default(now())

  @@index([range, createdAt])
  @@index([createdAt])
}

// ===================== DB BACKUP RUNS (v66 — بکاپ دوره‌ای دیتابیس) =====================
// دیریکتیو مالک: «دیتابیس هر ۲ ساعت بکاپ گرفته بشه و بیاد داخل گوگل درایو من؛
// فقط تا ۴۸ ساعت نگه داره، از ۴۸ ساعت به قبل پاک بشه.»
// بازهٔ بکاپ (۲/۳/۴/۵/۱۲ ساعت)، مقصد آپلود (لینک webhook) و نگهداری همه در
// SiteSetting است و از پنل ادمین تغییر می‌کند (کارت «بکاپ دیتابیس»).
// آپلود به Google Drive بدون Google Cloud API: با Google Apps Script Web App
// (کد آماده در کارت ادمین) — اسکریپت فایل را در پوشه ذخیره و فایل‌های
// قدیمی‌تر از ۴۸ ساعت را خودش حذف می‌کند.
model DbBackupRun {
  id          String   @id @default(cuid())
  status      String   // success | partial | failed
  trigger     String   @default("sweep") // sweep | manual | test_upload
  fileName    String?  // fitup-db-YYYY-MM-DD-HH-mm.db.gz
  sizeBytes   Int?     // حجم فایل فشرده
  localPath   String?  // db/backups/… (نسبی)
  uploaded    Boolean  @default(false) // آپلود به مقصد webhook موفق بود؟
  uploadError String?  // خطای آپلود (در صورت عدم موفقیت)
  deletedOld  Int      @default(0) // تعداد فایل‌های محلی قدیمی‌تر از نگهداری که حذف شدند
  durationMs  Int?     // مدت اجرا
  error       String?  // خطای کلی (در صورت failed)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

// ===================== TOOL USAGE FUNNEL (Task 5-e — قیف ابزارهای رایگان) =====================
// هر استفادهٔ موفق از ابزارهای رایگان لندینگ (TDEE / بانک غذاها / بانک حرکات)
// یک ردیف ثبت می‌کند تا قیف «استفادهٔ ابزار → ثبت‌نام → خرید» اندازه‌گیری شود.
// کاربر مهمان ثبت نمی‌شود (کلاینت فلگ localStorage نگه می‌دارد) — فقط لاگین‌ها.
model ToolUsage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tool      String   // "tdee" | "foods" | "exercises"
  result    String?  // خلاصهٔ نتیجه (مثلاً کالری محاسبه‌شده) — برای تحلیل قیف
  createdAt DateTime @default(now())

  @@index([tool, createdAt])
  @@index([userId])
}

// ===================== APP USAGE TIME (زمان مصرف اپ‌ها — v104) =====================
// هر «فلاش» ضربان‌سنج سمت کلاینت (هر ~۳۰ ثانیه فعالیت واقعی و قابل‌مشاهده) یک
// ردیف ثبت می‌کند: کاربر + پلتفرم (وب / اپ کافه‌بازار / اپ اختصاصی) + بخش فعال +
// مدت فعالیت در همان بازه. داشبورد مدیر → «میانگین زمان مصرف اپ‌ها (۲۴ ساعت)»
// از جمع همین ردیف‌ها محاسبه می‌شود:
//   مجموع زمان = Σ(seconds)  |  کاربر فعال = تعداد userId متمایز
//   میانگین هر کاربر = مجموع زمان ÷ کاربران فعال
// ردیف‌های بالای ۴۵ روز به‌صورت فرصت‌طلبانه در همین endpoint پاک می‌شوند.
model AppUsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "web" | "bazaar" | "own" — سمت سرور از User-Agent تعیین می‌شود (ورودی کلاینت مبنا نیست)
  platform  String
  // بخش فعال پنل: dashboard | programs | workouts | nutrition | progress | chat |
  // plans | referral | support | mobileapp | app (سایر)
  screen    String   @default("app")
  // مدت فعالیت واقعی در این بازه به ثانیه (کلاینت ≤ ۱۲۰ می‌فرستد؛ سرور سقف می‌زند)
  seconds   Int
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([platform, createdAt])
  @@index([userId, createdAt])
}

// ===================== ACTIVITY TRACKER (v138 — مسیریاب پیاده‌روی و دویدن) =====================
// هر جلسهٔ پیاده‌روی/دویدن ضبط‌شده با «مسیریاب فیتاپ» یک ردیف است:
//  • مسیر GPS به‌صورت JSON فشرده (آرایهٔ [lat, lng, tSec, accM]) — با کف دقت ۵۰ متر فیلتر می‌شود
//  • تشخیص نوع فعالیت خودکار سمت سرور بر اساس میانگین سرعت متحرک انجام می‌شود
//    (walk < 6.5 km/h ≤ jog < 8.5 ≤ run) — مقدار کلاینت فقط پیشنهاد است
//  • کالری سمت سرور با وزن واقعی کاربر (resolveWeightFromInputs) بازمحاسبه می‌شود
//  • ثبت برای «همه» کاربران رایگان است (بدون گیت پلن)؛ فقط «تزریق» در پروفایل
//    ورزشی/کانتکست هوش مصنوعی مخصوص پلن‌های فعال است (مصرف‌کننده‌های SPC ذاتاً پلن‌دارند)
model ActivitySession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "walk" | "jog" | "run" — تشخیص خودکار نهایی سمت سرور
  activityType String   @default("walk")
  // منبع ثبت: "gps" (مسیریاب) | "manual" (موقعتاً استفاده نشده)
  source       String   @default("gps")

  startedAt    DateTime
  endedAt      DateTime
  // مدت کل جلسه (شامل مکث‌ها) به ثانیه
  durationSec  Int
  // مدت واقعی «در حرکت» به ثانیه (مکث‌های > ۳ دقیقه حذف شده‌اند)
  movingSec    Int      @default(0)

  // متر — مسافت پاک‌شده (فیلترشده از نویز GPS)
  distanceM    Int
  // km/h — میانگین سرعت روی زمانِ متحرک
  avgSpeedKmh  Float    @default(0)
  maxSpeedKmh  Float    @default(0)
  // ثانیه بر کیلومتر (۰ = نامعتبر) — برای نمایش «ریتم»
  paceSecPerKm Int      @default(0)
  // کالری سوزانده‌شده (بازمحاسبهٔ سرور با وزن واقعی کاربر — MET-based)
  calories     Int      @default(0)
  // تخمین گام (از مسافت و نوع فعالیت)
  steps        Int      @default(0)
  // متر — جمع اختلاف ارتفاع صعودی (GPS؛ تخمینی)
  elevationGainM Int    @default(0)

  // مسیر GPS فشرده: "[[lat,lng,tSec,acc],...]" — گرد‌شده (lat/lng ۵ رقم اعشار، acc عدد صحیح)
  routeJson    String   @default("[]")
  // تعداد نقاط معتبر مسیر
  pointsCount  Int      @default(0)

  // عکس یادبود (webp بهینه — مثل گالری پیشرفت) — قابل حذف
  photoUrl     String?
  // یادداشت کاربر (اختیاری)
  note         String?

  createdAt    DateTime @default(now())

  @@index([userId, startedAt])
  @@index([startedAt])
}

// ═══════════════════════════════════════════════════════════════
// v183 — چالش‌های فیتاپ — پیشرفت کاربر در هر چالش (رایگان برای همه)
// محتوای چالش (تعریف + برنامهٔ روزانه) ثابت و جنسیتی است (challenges-data)
// و در DB نگه‌داری نمی‌شود؛ فقط پیشرفت هر کاربر اینجا ثبت می‌شود.
// ═══════════════════════════════════════════════════════════════
model ChallengeProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // slug چالش (m-sixpack-45 / w-glutes-30 ...)
  challengeSlug   String
  // روزهای تکمیل‌شده — JSON array از اعداد — "[1,2,3]"
  completedDays   String    @default("[]")
  // روز جاری پیشنهادی (آخرین روز تکمیل‌شده + ۱)
  currentDay      Int       @default(1)
  startedAt       DateTime  @default(now())
  lastCompletedAt DateTime?
  // تکمیل کامل چالش
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, challengeSlug])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// v198 — رویدادگذاری قیف فروش (دیرکتیو مالک: «تمام مراحل خرید رو در همه جا
// رویداد گذاری کنی و در پنل مدیر برام بیاری»)
// هر رویداد یک ردیف؛ مرحله‌ها با step مرتب می‌شوند. کاربر ناشناس هم ثبت
// می‌شود (userId nullable) و با sessionId مرورگر پیوند می‌خورد تا قیف کامل
// (حتی قبل از لاگین) دیده شود. کاتالوگ مراحل: src/lib/analytics/funnel.ts
// خطاهای JS مسیر جدا دارند: ErrorLog (با ددوپ و فیلتر نویز).
// ═══════════════════════════════════════════════════════════════
model FunnelEvent {
  id        String   @id @default(cuid())
  kind      String   @default("funnel") // funnel
  event     String   // نام استاندارد رویداد (whitelist در کاتالوگ)
  step      Int      @default(0) // ترتیب مرحله در قیف (مرتب‌سازی داشبورد)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String   @default("") // سشن ناشناس مرورگر (localStorage)
  path      String?  // صفحهٔ وقوع رویداد
  planId    String?  // پلن مرتبط (اگر رویداد پلنی باشد)
  amount    Int?     // مبلغ مرتبط (تومان) در لحظهٔ رویداد
  device    String?  // android | ios | desktop | unknown
  source    String?  // instagram | app_android | bazaar | web | unknown
  meta      String?  // JSON آزاد (دلیل شکست، کد تخفیف، روش پرداخت و…)
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@index([sessionId])
}
