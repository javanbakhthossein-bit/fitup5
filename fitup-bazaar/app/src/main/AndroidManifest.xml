<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اپ یک WebView از سایت فیتاپ است؛ فقط اینترنت لازم است (حداقل دسترسی — قانون حریم خصوصی بازار) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- نوتیف سیستم اندروید ۱۳+ (runtime request در MainActivity) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v31 — رسیدن اعلان‌ها حتی وقتی برنامه بسته است:
         دیالوگ اختیاری فارسی یک‌بار-محور (requestBatteryOptimization از پل وب،
         بعد از رضایت اعلان‌ها) — مصرف باتری به‌طور محسوسی بالا نمی‌رود -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v1.5.4 — ماندگاری اعلان‌های دوره‌ای بعد از ریبوت:
         WorkManager برای بازچینش کارهای دوره‌ای بعد از خاموش/روشن شدن گوشی به این
         پرمیشن نیاز دارد (کتابخانهٔ work-runtime خودش آن را merge می‌کند؛ اینجا
         صریحاً نوشته شده تا وابسته به merge پنهان نباشد) — کم‌مصرف، بدون سرویس دائمی -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ⛔ عمداً هیچ پرمیشن پیامک (RECEIVE_SMS/READ_SMS/SEND_SMS) وجود ندارد.
         علت ریشه‌ای: از اندروید ۱۳+ پرمیشن‌های SMS «محدود» هستند و برای اپ‌های
         خارج از گوگل‌پلی (از جمله کافه‌بازار) سیستم اجازهٔ اعطا را کلاً می‌بندد و
         همان دیالوگ ترسناک «App was denied access» را نشان می‌دهد؛ یعنی درخواستش
         هم بی‌فایده است و هم اعتماد کاربر را می‌شکند (و با قانون حریم خصوصی بازار
         سازگارتر است).
         ورود خودکار OTP حالا بدون هیچ پرمیشنی انجام می‌شود:
         ۱) autocomplete="one-time-code" روی ورودی کد → پیشنهاد سیستم/کیبورد
         ۲) اتو-درج از کلیپ‌بورد (maybeDispatchClipboardOtp)
         ۳) SMS Retriever رسمی گوگل (v31 — بدون پرمیشن؛ پیامک با هش اپ امضا می‌شود)
         ۴) ورود دستی. -->

    <!-- دوربین/میکروفون وب: مجوزها «در زمان استفاده» گرفته می‌شوند — نه در استارتاپ.
         WebChromeClient.onPermissionRequest دقیقاً وقتی اجرا می‌شود که سایت ضبط صدا
         (چت صوتی/ویس) یا ضبط ویدیو (آنالیز ویدیویی تمرین/بدن) بخواهد؛ کاربر ابتدا
         دیالوگ فارسی اجازه را می‌بیند و بعد دیالوگ سیستمی اندروید. هیچ چیزی خارج
         از آن لحظه ضبط/ذخیره نمی‌شود (قانون حریم خصوصی بازار). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- اندروید ۱۱+ : برای bind شدن به سرویس پرداخت بازار، پکیج بازار باید visible باشد -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
        <intent>
            <action android:name="ir.cafebazaar.pardakht.InAppBillingService.BIND" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitUp"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v1.5.4 — Android App Links: باز شدن لینک‌های https://fittup.ir داخل اپ
                 (به‌جای مرورگر). تأیید مالکیت دامنه با فایل
                 /.well-known/assetlinks.json روی سایت — فقط https و فقط دامنهٔ خودمان،
                 پارامترها (?tab= ?ref= ?renewal= ?screen= ?article=) دست‌نخورده می‌مانند -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fittup.ir" />
                <!-- v1.5.8 — پوشش زیردامنهٔ www (بعضی لینک‌های پیامک/وبلاگ با www می‌آیند) -->
                <data android:scheme="https" android:host="www.fittup.ir" />
            </intent-filter>
            <!-- v1.5.5 — اسکیم اختصاصی fitup:// برای لینک‌های هوشمند پیامک:
                 دستگاه‌های بدون سرویس گوگل autoVerify را تأیید نمی‌کنند و لینک
                 https در مرورگر باز می‌شد. صفحهٔ /go سایت با intent:// این اسکیم
                 را صدا می‌زند (fitup://open?url=...) تا اپ مستقیم باز شود؛
                 اگر اپ نصب نبود، همان لینک در مرورگر fallback می‌شود -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fitup" />
            </intent-filter>
        </activity>
    </application>
</manifest>
