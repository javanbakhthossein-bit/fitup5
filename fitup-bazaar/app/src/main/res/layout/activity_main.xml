<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- اسپلش برندینگ تا آماده شدن اولین صفحه (شروع با OTP) -->
        <LinearLayout
            android:id="@+id/splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/splash_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="فیتاپ"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="فیتاپ"
                android:textColor="@color/splash_title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashSlogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/splash_slogan"
                android:textColor="#f97316"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/splashSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:indeterminateTint="#f97316" />
        </LinearLayout>


        <!-- v1.15.0 — لوگوموشن ویدیویی اسپلش: در شروع سرد، ویدیوی برند فیتاپ پخش می‌شود؛
             با یک تپ رد می‌شود و در پایان/خطا/واچداگ خودکار مخفی می‌گردد (فیل‌سیف در MainActivity).
             اگر raw/logo_motion.mp4 موجود نباشد این لایه هرگز نمایان نمی‌شود — اسپلش قبلی دست‌نخورده -->
        <FrameLayout
            android:id="@+id/splashVideoWrap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/intro_bg"
            android:visibility="gone">

            <VideoView
                android:id="@+id/splashVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- v1.19.0 — پوستر فریم اول: سطح VideoView تا آماده‌شدن MediaPlayer مشکی است؛
                 این پوستر (عین فریم اول ویدیو) روی آن می‌نشیند و ۲۵۰ms بعد از شروع پخش
                 برداشته می‌شود — کاربر از لحظهٔ صفر فقط «شروع ویدیو» را می‌بیند -->
            <ImageView
                android:id="@+id/splashVideoPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="فیتاپ"
                android:src="@drawable/intro_poster" />
        </FrameLayout>

        <!-- v1.19.0 (v224 — دیرکتیو مالک) — نمای «اتصال برقرار نیست / در حال اتصال»
             برای همیشه حذف شد: هر جا صفحه آماده نبود، خودِ اسپلش برند فیتاپ (لوگو + شعار +
             اسپینر) روی میز می‌ماند و حلقهٔ اتصال خودکار در MainActivity تا پینت صفحه
             تلاش می‌کند. دیگر هیچ صفحهٔ اضافه‌ای بین ویدیو و داشبورد وجود ندارد. -->
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
